    <script>
      /* 白天进度（0 = 夜，1 = 正午）。
         标题是另一块画布、单独绘制的，靠下面这个回调把进度喂进去 ——
         天亮之后标题必须从浅青换成深蓝，否则浅字压在亮天上直接糊掉。 */
      let titleDayness = 0;
      let titleRedraw: ((d: number) => void) | null = null;

      /* ============================================================
         标题：像素字（和背景星海无关，先单独跑完）
         ------------------------------------------------------------
         字形取自「缝合像素字体 Fusion Pixel 12px」的 9 行点阵，逐格采样后
         只留下标题用得到的 7 个字母（W I R E D N O）硬编码在这里 ——
         比整份字体小三个数量级，也守住了本站「零外部字体 / 零资源文件」的底线。

         画法分两步，顺序不能反：
           1. 先把点阵铺成**实心**的字（相邻格子不留缝）；
           2. 再用横向扫描线把整字高切成 5 段，每段实心 90.5%。
         于是竖笔断成一串方点，而横笔比一段还矮、整段落在实心里，保持实心 ——
         这正是参考图里那种「数字表盘」的观感（实测参考图：方点 43px / 间隙 4.5px）。

         同一行里相邻的格子要**合并成一个矩形**再画：逐个画圆角矩形的话，
         横笔上会被圆角切出一排细缝，实心条就没了。
         ============================================================ */
      {
        const GLYPHS: Record<string, string[]> = {
          W: ['111', '111', '111', '0aa', '0aa', '0aa', '044', '044', '044'],
          I: ['7', '2', '2', '2', '2', '2', '2', '2', '7'],
          R: ['3e', '21', '21', '21', '3e', '28', '24', '22', '21'],
          E: ['3f', '20', '20', '20', '3e', '20', '20', '20', '3f'],
          D: ['3c', '22', '21', '21', '21', '21', '21', '22', '3c'],
          N: ['21', '31', '29', '29', '25', '25', '23', '23', '21'],
          O: ['1c', '22', '41', '41', '41', '41', '41', '22', '1c'],
          /* L：左侧一竖到底 + 底下一横。0x20 = 100000（只有最左那一列），
             0x3f = 111111（整行）。
             ⚠️ 顶行**不能**写成 0x3f —— 那样上下各一横就成了「C」。
             E 的顶行是 0x3f 因为 E 真的有一条上横，L 没有。 */
          L: ['20', '20', '20', '20', '20', '20', '20', '20', '3f'],
        };
        const GLYPH_W: Record<string, number> = { W: 9, I: 3, R: 6, E: 6, D: 6, N: 6, O: 7, L: 6 };
        const ROWS = 9;
        const TITLE = 'WIRED WORLD';
        const LETTER_GAP = 1; // 字间距（格）
        const WORD_GAP = 7; // 空格宽（格）
        const BANDS = 5; // 整字高切成几段扫描线
        const INK = 0.905; // 每段里实心的比例（参考图实测 43 / 47.5）

        /* 把标题展开成「每列一个 9 位掩码」，列是画布的唯一坐标 */
        const columns: number[] = [];
        for (const ch of TITLE) {
          if (ch === ' ') {
            for (let i = 0; i < WORD_GAP; i += 1) columns.push(0);
            continue;
          }
          const glyph = GLYPHS[ch];
          const gw = GLYPH_W[ch];
          for (let c = 0; c < gw; c += 1) {
            let mask = 0;
            for (let r = 0; r < ROWS; r += 1) {
              const bits = parseInt(glyph[r], 16).toString(2).padStart(gw, '0');
              if (bits[c] === '1') mask |= 1 << r;
            }
            columns.push(mask);
          }
          for (let i = 0; i < LETTER_GAP; i += 1) columns.push(0);
        }
        while (columns.length && columns[columns.length - 1] === 0) columns.pop();
        const COLS = columns.length;

        const canvas = document.getElementById('title-glyphs') as HTMLCanvasElement | null;
        const host = canvas?.parentElement ?? null;

        const roundRect = (
          ctx: CanvasRenderingContext2D,
          x: number,
          y: number,
          w: number,
          h: number,
          r: number,
        ) => {
          const rr = Math.min(r, w / 2, h / 2);
          ctx.beginPath();
          ctx.moveTo(x + rr, y);
          ctx.lineTo(x + w - rr, y);
          ctx.quadraticCurveTo(x + w, y, x + w, y + rr);
          ctx.lineTo(x + w, y + h - rr);
          ctx.quadraticCurveTo(x + w, y + h, x + w - rr, y + h);
          ctx.lineTo(x + rr, y + h);
          ctx.quadraticCurveTo(x, y + h, x, y + h - rr);
          ctx.lineTo(x, y + rr);
          ctx.quadraticCurveTo(x, y, x + rr, y);
          ctx.closePath();
          ctx.fill();
        };

        let drawnW = 0;
        let drawnDpr = 0;
        let drawnTone = -1;

        /** 两个 #rrggbb 按 t 混合 */
        const mixHex = (a: string, b: string, t: number) => {
          const pa = parseInt(a.slice(1), 16);
          const pb = parseInt(b.slice(1), 16);
          const ch = (sh: number) =>
            Math.round(((pa >> sh) & 255) * (1 - t) + ((pb >> sh) & 255) * t);
          return `rgb(${ch(16)}, ${ch(8)}, ${ch(0)})`;
        };

        const drawTitle = (tone = 0) => {
          if (!canvas || !host) return;
          const cssW = Math.round(host.clientWidth);
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          if (cssW < 60 || (cssW === drawnW && dpr === drawnDpr && tone === drawnTone)) return;
          drawnW = cssW;
          drawnDpr = dpr;
          drawnTone = tone;

          const cell = cssW / COLS;
          const cssH = cell * ROWS;

          canvas.width = Math.round(cssW * dpr);
          canvas.height = Math.round(cssH * dpr);
          canvas.style.height = `${cssH}px`;

          const ctx = canvas.getContext('2d');
          if (!ctx) return;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, cssW, cssH);

          /* 左上最亮、右下收暗。夜里是浅青（深底上发亮），白天换成很深的藏蓝 ——
             亮天上再放浅青会糊成一片；而白天这套必须**压得够深**，
             因为底色抬亮之后，稍浅一点的蓝就落到和天差不多的亮度上去了。 */
          const grad = ctx.createLinearGradient(0, 0, cssW, cssH);
          grad.addColorStop(0, mixHex('#eaf9ff', '#061a2c', tone));
          grad.addColorStop(0.5, mixHex('#9adcff', '#0b2f4a', tone));
          grad.addColorStop(1, mixHex('#4f9fc8', '#104566', tone));
          ctx.fillStyle = grad;

          const radius = Math.max(0.5, cell * 0.12);
          const period = cssH / BANDS;
          const ink = period * INK;

          for (let b = 0; b < BANDS; b += 1) {
            const by0 = b * period;
            const by1 = Math.min(by0 + ink, cssH);
            for (let r = 0; r < ROWS; r += 1) {
              const py0 = Math.max(by0, r * cell);
              const py1 = Math.min(by1, (r + 1) * cell);
              if (py1 - py0 <= 0.25) continue;
              let c = 0;
              while (c < COLS) {
                if (!(columns[c] & (1 << r))) {
                  c += 1;
                  continue;
                }
                // 横向合并连续的格子，横笔才是整条而不是一排点
                let c2 = c;
                while (c2 + 1 < COLS && columns[c2 + 1] & (1 << r)) c2 += 1;
                roundRect(ctx, c * cell, py0, (c2 - c + 1) * cell, py1 - py0, radius);
                c = c2 + 1;
              }
            }
          }
        };

        if (canvas && host) {
          let curTone = 0;
          const redraw = () => drawTitle(curTone);
          redraw();
          if ('ResizeObserver' in window) {
            new ResizeObserver(redraw).observe(host);
          } else {
            window.addEventListener('resize', redraw, { passive: true });
          }
          /* 把重画入口交给主脚本：白天进度跨过一档才真的重画（drawTitle 自己会挡掉） */
          titleRedraw = (d: number) => {
            curTone = Math.pow(Math.min(1, Math.max(0, d)), 0.75);
            redraw();
          };
        }
      }

      type Mode = 'ascii' | 'binary';

      const TAU = Math.PI * 2;

      /* 天空向左漂移的速度：每秒推进视口宽度的比例。
         0.0075 = 一分钟走掉小半个屏 —— 慢到不会让人分心，又足够在一首歌里看出变化。 */
      const SKY_DRIFT = 0.0075;

      /* ============================================================
         天空的钟：月亮与星星的位置由**访问者的本地时间**决定
         ------------------------------------------------------------
         日落 18:00 → 月亮从东边（画面右侧）升起；
         午夜 00:00 → 到天顶；
         日出 06:00 → 落到西边（画面左侧）落下。
         12 小时的夜归一化成 u ∈ [0, 1)：0 刚升起、0.5 最高、1 刚落。

         白天（u ≥ 1）月亮在地平线以下，整轮不画 —— 白天的画面（太阳、
         天色、云的亮度）是另一件事，这一步不做，天空仍旧是夜空的样子。

         ?t=HH:MM 可以覆盖本地时间，方便对时（不写就用系统时间）。
         ============================================================ */
      const SUNSET_H = 18;
      const NIGHT_H = 12;

      const timeOverride = (() => {
        const m = /[?&]t=(\d{1,2})(?::(\d{2}))?/.exec(location.search);
        if (!m) return null;
        return { h: Number(m[1]) % 24, m: Number(m[2] ?? 0) % 60 };
      })();

      const clockNow = () => {
        const d = new Date();
        if (timeOverride) d.setHours(timeOverride.h, timeOverride.m, 0, 0);
        return d;
      };

      /* ---------- 黄金时刻的开关 ----------
         GOLD_ENABLED = true  —— 全站按访客的本地时间自动出日出日落。
         GOLD_ENABLED = false —— 整条路都不走，渲染与加这个功能之前逐位一致。

         调试用的 ?gold= 参数只在 GOLD_ENABLED = false 时才有意义：
           ?gold=1 或 ?gold     —— 强度按本地时间自动
           ?gold=0.7            —— 把强度钉死在 0.7，方便并排比较不同档位
         上线之后这个参数被忽略 —— 访客没法自己把黄金时刻摇出来。

         ⚠️ 这个常量必须声明在 goldArg **之前**。原来它放在下面（配色表那一带），
         压缩器把两个不同作用域里的短名重成了同一个 `_`，`goldArg` 读到的是
         别处那个变量 —— 结果 `?gold=` 参数时灵时不灵。同名的短变量在打包后
         会互相遮蔽，这类跨作用域的引用不要留。 */
      const GOLD_ENABLED: boolean = true; // 上线总闸：全站按本地时间自动出日出日落

      const goldArg: number | 'auto' | null = GOLD_ENABLED
        ? 'auto'
        : (() => {
            const m = /[?&]gold(?:=([\d.]+))?/.exec(location.search);
            if (!m) return null;
            if (m[1] === undefined) return 'auto';
            const v = Number(m[1]);
            return !Number.isFinite(v) || v >= 1 ? 'auto' : Math.max(0, v);
          })();

      /** 当前时刻在夜里的归一化位置；白天落在 [1, 2) */
      const nightPhase = () => {
        const d = clockNow();
        const hours = d.getHours() + d.getMinutes() / 60 + d.getSeconds() / 3600;
        return (((hours - SUNSET_H + 24) % 24) / NIGHT_H);
      };

      /* 月亮的夜行轨迹：东升西落，中间划一道弧。
         横坐标从左到右是线性的，纵坐标走一条 sin^1.3 的弧 ——
         幂次比 1 大一点，月亮在贴近两端时才压得住，不会刚出来就窜到半空。 */
      const MOON_RISE_X = 1.03; // 升起时刚出画面右侧一点
      const MOON_SET_X = -0.03; // 落下时刚好出了左侧
      const MOON_ARC_POW = 1.3;

      /* 星空整夜转过的宽度（屏）：和月亮同向，天球才是一起转的 */
      const SKY_NIGHT_SPAN = 1.05;

      /* ============================================================
         白天的天光
         ------------------------------------------------------------
         06:00 日出 → 12:00 天顶 → 18:00 日落。天顶深、地平线亮 ——
         大气越靠近地平线越厚，真实的白昼也是那一带最白。
         dayness 用 sin^0.55 而不是 sin：一次方在 07:00 才爬到 0.26，
         天迟迟不亮；压到 0.55 之后 07:00 已经有 0.5，天亮得快、黄昏暗得也快。
         ============================================================ */
      const DAY_CURVE = 0.55;

      /* ------------------------------------------------------------
         白天的配色（定档：更亮更暖）
         ------------------------------------------------------------
         天空是**一整片纯色渐变**，海面抬亮并往青里偏。
         两点是调出来的、不是拍的：
           · 地平线的暖白要**先把饱和度褪掉再染暖**（见 warmBlend）——
             蓝色相直接插到暖色相会从绿色穿过去。
           · 天空的渐变必须铺满铺实：橙色的亮度天生比暖白低，
             同样的透明度铺上去会闷成一层灰褐色（见 skySolid 那条斜坡）。
         ------------------------------------------------------------ */
      const DAY_TONE = {
        zen: 0.6, // 天顶的字符亮度（现在只喂给 toneGain）
        hor: 1.2, // 地平线的字符亮度
        warm: 0.92, // 地平线光带往暖里偏多少
        warmHue: 0.095, // 暖的那一头落在哪个色相（0.095 ≈ 34°，橙）
        warmSat: 0.22, // 暖的那一头最高能给到多少饱和度
        sea: 2.5, // 海面整体抬亮的倍数
        seaWarm: 0.6, // 海面往暖里偏多少
        fillTop: '#1a63ad', // 天空渐变：天顶（偏深的蓝）
        fillBot: '#cfd2c8', // 天空渐变：地平线（暖白）
        seaDeep: '#1a4d6b', // 海面底色的最深处
        titleDark: 1, // 标题跟着转深藏蓝
      };
      type Tone = typeof DAY_TONE;

      /* 大气（雾带、地平线光带）的亮度跟着白天配色一起抬。
         1.06 = 原先那一档的天顶 + 地平线总量，用来把倍率归一到 1。
         每帧取 toneGain(tone)（见 drawScene），黄金时刻用的是它自己那一档。 */
      const toneGain = (tn: Tone) => (tn.zen + tn.hor) / 1.06;

      /** 蓝 → 暖白，返回 [色相, 饱和度]。
          直接插色相会从绿色穿过去（198° → 34° 中间是 115° 的黄绿），
          所以分两段走：先把蓝褪成灰（色相不动、饱和度归零），再给灰染上暖。
          交接点上饱和度正好是 0，色相怎么跳都看不出来。

          wHue / wSat 是「暖的那一头」长什么样。默认值就是白天那一档（淡橙、低饱和），
          黄金时刻会把它们推到深橙 + 高饱和 —— 同一个函数、两套终点。 */
      const warmBlend = (
        hueBase: number,
        satBase: number,
        w: number,
        wHue = 0.095,
        wSat = 0.22,
      ): [number, number] =>
        w <= 0.5
          ? [hueBase, satBase * (1 - w * 2)]
          : [lerp(hueBase, wHue, (w - 0.5) * 2), wSat * (w - 0.5) * 2];

      /* ============================================================
         日出 / 日落（黄金时刻）
         ------------------------------------------------------------
         白天的配色只在「太阳挂高」的时候成立。太阳一贴到地平线，真实世界里
         发生的是三件事，这里各用一个量去逼近：

           1. 太阳**看起来更大**。大气折射 + 心理上的参照效应，
              贴着海面的一轮日面比头顶上大得多 —— 这里把日面半径乘 1.55。
              放大的是**半径**，轨迹和圆心不动，所以升落时刻一点没变。
           2. 整条地平线**烧起来**。天顶还留着深蓝，越往下越橙 ——
              所以只把 hueBot 那一头推向暖，hueTop 反而往靛紫里压一点：
              上冷下暖的落差才是黄昏，两头一起暖就成了一张滤色片。
              同时把暖的那一头从「淡橙 0.22 饱和」推到「深橙 0.74 饱和」，
              不然地平线只是一层灰扑扑的米色。
           3. 海面接住那片橙。底色渐变的底端从暖白换成橙，
              太阳那条碎光路更宽、更暖、更碎。

         天光本身也要重排：靛 → 紫玫瑰 → 橙 → 亮黄，**四段**。
         只给「靛 → 橙」两个色标的话，中间会从灰里穿过去，烧不起来。

         goldW = 离地平线有多近。日出段 [0, GOLD_SPAN] 由 1 淡到 0，
         日落段 [1-GOLD_SPAN, 1] 由 0 淡到 1，两段取大 ——
         所以 06:40 和 17:20 是同一个强度，日出日落共用一套参数、方向相反。

         开关见下面的 GOLD_ENABLED 与 ?gold= 参数。
         ============================================================ */
      const GOLD_SPAN = 0.17; // 黄金时刻各占白天两头多大一段（0.17 ≈ 2 小时）
      const GOLD_SUN_R = 1.55; // 日面半径的放大倍数
      const GOLD_SUN_HUE = 0.042; // 日面在黄金时刻的色相（深橙）
      const GOLD_WARM_HUE = 0.042; // 地平线暖的那一头
      const GOLD_WARM_SAT = 0.74; // 地平线暖的那一头的饱和度（黄昏该是烧起来的）
      const GOLD_SKY_MID = '#9a5a86'; // 天空渐变中段：紫玫瑰
      const GOLD_SKY_DUSK = '#f2a49e'; // 天空渐变下段：暮粉（雾带那一片）
      const GOLD_SKY_HOR = '#fff0c8'; // 天空渐变贴地平线的那一头：亮奶油黄
      const GOLD_SEA_MID = '#5b3f63'; // 海面渐变：金带往下沉的紫

      const GOLD_TONE: Tone = {
        zen: 0.5, // 天顶压暗一点，落差才出得来
        hor: 1.5, // 地平线更亮：那是太阳沉下去的地方
        warm: 1, // 暖到顶
        warmHue: GOLD_WARM_HUE,
        warmSat: GOLD_WARM_SAT,
        sea: 2.9,
        seaWarm: 0.95,
        fillTop: '#2f3d7a', // 天空渐变：天顶（靛）
        fillBot: '#ffc684', // 天空渐变：地平线（橙）
        seaDeep: '#2a2f4d', // 海面深处：紫蓝
        titleDark: 1,
      };

      /** #rrggbb → [r, g, b] */
      const hex2rgb = (h: string): [number, number, number] => [
        parseInt(h.slice(1, 3), 16),
        parseInt(h.slice(3, 5), 16),
        parseInt(h.slice(5, 7), 16),
      ];
      /** 两个 #rrggbb 之间插值：w = 0 取 a，w = 1 取 b。
          颜色必须按 **RGB 通道**插，不能按色相插 —— 靛 → 橙的色相路径会穿过绿色。 */
      const mixHex = (a: string, b: string, w: number): string => {
        const ca = hex2rgb(a);
        const cb = hex2rgb(b);
        let out = '#';
        for (let i = 0; i < 3; i += 1) {
          const v = Math.max(0, Math.min(255, Math.round(lerp(ca[i], cb[i], w))));
          out += v.toString(16).padStart(2, '0');
        }
        return out;
      };

      /** #rrggbb + 透明度 → 'rgba(r, g, b, a)'。
          黄金时刻的天空渐变要在**竖直方向**上自带一条透明度曲线（下亮上暗），
          所以不能只靠 ctx.globalAlpha 一个数。 */
      const rgba = (h: string, a: number): string => {
        const c = hex2rgb(h);
        return `rgba(${c[0]}, ${c[1]}, ${c[2]}, ${a})`;
      };

      /** 这一帧实际用的配色。
          goldW ≤ 0.001 时**原样返回 DAY_TONE**（同一个对象引用），
          所以白天那一档的渲染结果与加黄金时刻之前逐位相同。 */
      const toneAt = (goldW: number): Tone => {
        if (goldW <= 0.001) return DAY_TONE;
        return {
          zen: lerp(DAY_TONE.zen, GOLD_TONE.zen, goldW),
          hor: lerp(DAY_TONE.hor, GOLD_TONE.hor, goldW),
          warm: lerp(DAY_TONE.warm, GOLD_TONE.warm, goldW),
          warmHue: lerp(DAY_TONE.warmHue, GOLD_TONE.warmHue, goldW),
          warmSat: lerp(DAY_TONE.warmSat, GOLD_TONE.warmSat, goldW),
          sea: lerp(DAY_TONE.sea, GOLD_TONE.sea, goldW),
          seaWarm: lerp(DAY_TONE.seaWarm, GOLD_TONE.seaWarm, goldW),
          fillTop: mixHex(DAY_TONE.fillTop, GOLD_TONE.fillTop, goldW),
          fillBot: mixHex(DAY_TONE.fillBot, GOLD_TONE.fillBot, goldW),
          seaDeep: mixHex(DAY_TONE.seaDeep, GOLD_TONE.seaDeep, goldW),
          titleDark: DAY_TONE.titleDark,
        };
      };

      /* 画面三段的分界（占视口高度的比例）：天空 → 流星带 → 海面。
         中间这段就是新长出来的「背景长度」：天和海不再硬碰硬地接在一起，
         而是隔着一整条过渡带，纵深也就多了一层。 */
      const SKY_EDGE = 0.45;
      const SEA_EDGE = 0.63;

      const FONT =
        'ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "PingFang SC", "Microsoft YaHei", monospace';

      /* 字符集：从暗到亮。
         ASCII 是经典密度阶梯；01 只有两级，中间调交给有序抖动去表达。 */
      const RAMPS: Record<Mode, string> = {
        ascii: ' .,:;-~=+*#%@',
        binary: ' 01',
      };

      /* 4×4 有序抖动矩阵（已归一化到 0..1）：
         01 模式下，亮度高于阈值画 1，否则画 0 —— 一片区域的 1 越密就越亮。 */
      const BAYER = new Float32Array([
        0.03, 0.53, 0.16, 0.66,
        0.78, 0.28, 0.91, 0.41,
        0.19, 0.69, 0.09, 0.59,
        0.94, 0.44, 0.84, 0.34,
      ]);

      /* 颜色查表：把 (色相 × 饱和度 × 明度) 预先算成字符串，
         每帧只做整数索引，避免在循环里拼字符串产生大量垃圾。 */
      const HUE_STEPS = 32;
      const SAT_STEPS = 4;
      const LIT_STEPS = 22;
      const palette: string[] = new Array(HUE_STEPS * SAT_STEPS * LIT_STEPS);
      for (let h = 0; h < HUE_STEPS; h += 1) {
        const hue = Math.round((h * 360) / HUE_STEPS);
        for (let s = 0; s < SAT_STEPS; s += 1) {
          const sat = Math.round((s / (SAT_STEPS - 1)) * 100);
          for (let l = 0; l < LIT_STEPS; l += 1) {
            const lit = Math.round(5 + (l / (LIT_STEPS - 1)) * 75);
            palette[(h * SAT_STEPS + s) * LIT_STEPS + l] = `hsl(${hue}, ${sat}%, ${lit}%)`;
          }
        }
      }

      const clamp = (v: number, lo: number, hi: number) => (v < lo ? lo : v > hi ? hi : v);
      /** 取模，结果永远落在 [0, m)：天空里的东西绕到另一端时用它 */
      const wrap = (v: number, m: number) => {
        const r = v % m;
        return r < 0 ? r + m : r;
      };
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const smoothstep = (a: number, b: number, x: number) => {
        if (a === b) return x < a ? 0 : 1;
        const t = clamp((x - a) / (b - a), 0, 1);
        return t * t * (3 - 2 * t);
      };

      /* 确定性哈希：同一个格子每帧得到同一个值。
         画面里所有的「随机」都在初始化时定好，绝不用逐帧随机数 —— 那是闪烁，是噪音。 */
      const hash2 = (x: number, y: number) => {
        let h = Math.imul(x | 0, 374761393) ^ Math.imul(y | 0, 668265263);
        h = Math.imul(h ^ (h >>> 13), 1274126177);
        return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
      };

      const valueNoise = (x: number, y: number) => {
        const xi = Math.floor(x);
        const yi = Math.floor(y);
        const xf = x - xi;
        const yf = y - yi;
        const u = xf * xf * (3 - 2 * xf);
        const v = yf * yf * (3 - 2 * yf);
        const a = hash2(xi, yi);
        const b = hash2(xi + 1, yi);
        const c = hash2(xi, yi + 1);
        const d = hash2(xi + 1, yi + 1);
        return lerp(lerp(a, b, u), lerp(c, d, u), v);
      };

      /** 三层叠加的分形噪声：星云的形状 */
      const fbm = (x: number, y: number) =>
        valueNoise(x, y) * 0.62 +
        valueNoise(x * 2.03 + 11.3, y * 2.07 + 7.1) * 0.28 +
        valueNoise(x * 4.1 + 3.7, y * 4.2 + 1.9) * 0.1;

      interface Star {
        x: number;
        y: number;
        z: number;
        hue: number;
        sat: number;
        phase: number;
        tw: number;
      }

      /** 一颗流星：一条定死的轨道，之后只按时间循环，没有任何逐帧随机 */
      interface Meteor {
        x: number;
        par: number;
        speed: number;
        phase: number;
        len: number;
        slant: number;
        gain: number;
        hue: number;
        sat: number;
      }

      /* ============================================================
         热气球与帆船：**每一只都不一样**
         ------------------------------------------------------------
         第一版所有气球是同一个球型、所有帆船是同一套帆 —— 天上飘三只
         一模一样的气球，海上走四条一模一样的船，一眼就看出来是复制品。
         这里把「形状」和「花纹」拆成两个维度，初始化时各抽一次，
         之后定死不动（逐帧随机就成了闪烁，那又是噪音）。

         形状用参数描述而不是写四份画法：hMul 纵向拉伸、taper 往下收多少
         （负数就是往下张，成梨形）、后面几个是收颈 / 吊索 / 吊篮的相对宽度。
         帆船同理，hull / mast / main 都是相对船长 s 的倍数。
         ============================================================ */
      type BalloonKind = 'round' | 'tall' | 'pear' | 'squat';
      type BalloonPattern = 'vstripe' | 'hstripe' | 'plain' | 'check' | 'crown';
      type BoatKind = 'sloop' | 'square' | 'schooner' | 'dinghy';

      const BALLOON_SHAPES: Record<
        BalloonKind,
        { hMul: number; taper: number; neckW: number; ropeW: number; basketW: number }
      > = {
        // 常见的那种：宽圆、往下收成一个口
        round: { hMul: 1, taper: 0.44, neckW: 0.15, ropeW: 0.2, basketW: 0.28 },
        // 细高，收得少 —— 远看像一颗立着的蛋
        tall: { hMul: 1.34, taper: 0.24, neckW: 0.12, ropeW: 0.16, basketW: 0.22 },
        // 梨形：下半截比赤道还宽，收口最急
        pear: { hMul: 1.04, taper: -0.18, neckW: 0.2, ropeW: 0.27, basketW: 0.34 },
        // 矮胖，赤道压得最低
        squat: { hMul: 0.76, taper: 0.52, neckW: 0.18, ropeW: 0.25, basketW: 0.33 },
      };

      const BOAT_SHAPES: Record<
        BoatKind,
        { hull: number; depth: number; mast: number; main: number; jib: number; masts: number }
      > = {
        // 单桅 + 三角主帆 + 前帆（最经典的那条）
        sloop: { hull: 1, depth: 0.62, mast: 2.2, main: 1.5, jib: 0.72, masts: 1 },
        // 单桅方帆：一块上窄下宽的梯形，没有前帆
        square: { hull: 1.06, depth: 0.58, mast: 2.5, main: 1.95, jib: 0, masts: 1 },
        // 双桅：两根桅杆各挂一片三角帆，船身也长一些
        schooner: { hull: 1.2, depth: 0.66, mast: 1.9, main: 1.05, jib: 0, masts: 2 },
        // 小艇：船小、桅矮、只有一片小帆
        dinghy: { hull: 0.74, depth: 0.7, mast: 1.65, main: 1.25, jib: 0, masts: 1 },
      };

      /** 一只热气球：球体 + 收颈 + 吊篮，整体极慢地横移，偶尔上下浮一点 */
      interface Balloon {
        x: number;
        y: number;
        r: number;
        speed: number;
        hue: number;
        hue2: number;
        bob: number;
        kind: BalloonKind;
        pattern: BalloonPattern;
        /** 条纹疏密与相位：同一个花纹在不同气球上也不同 */
        sf: number;
        sp: number;
      }

      /** 鸟群里的一只鸟：相对群心的偏移 + 扇翅相位 */
      interface Bird {
        dx: number;
        dy: number;
        phase: number;
        flap: number;
      }

      /** 一群鸟：整体横移，队形是松散的 V（一只领头，两侧依次排开） */
      interface Flock {
        x: number;
        y: number;
        speed: number;
        bob: number;
        birds: Bird[];
      }

      /** 一条帆船：在海面上按深度缩放，慢速横移，随浪轻轻起伏 */
      interface Boat {
        x: number;
        /** 深度：0 贴着地平线（远、小），1 贴着画面底（近、大） */
        v: number;
        speed: number;
        dir: number;
        phase: number;
        kind: BoatKind;
      }

      const canvas = document.getElementById('field') as HTMLCanvasElement | null;
      const ctx = canvas?.getContext('2d', { alpha: true }) ?? null;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      let W = 0;
      let H = 0;
      let cols = 0;
      let rows = 0;
      let cellW = 8;
      let cellH = 16;
      let bandTop = 0;
      let horizon = 0;
      let aspect = 1.7;
      let intensity = new Float32Array(0);
      let hueBuf = new Float32Array(0);
      let satBuf = new Float32Array(0);
      let stars: Star[] = [];
      let meteors: Meteor[] = [];
      let balloons: Balloon[] = [];
      let flocks: Flock[] = [];
      let boats: Boat[] = [];
      let moonR = 4;
      let mode: Mode = 'ascii';

      /* 首屏之后自适应降级用：掉帧就减少列数（字符变大、数量变少） */
      let quality = 1;
      let costAvg = 8;
      let frameCount = 0;
      /* 标题晕罩的当前不透明度，用来避免每帧重复写 CSS 变量 */
      let lastHalo = -1;
      /* 白天的底色渐变：drawScene 写、render 读。
         字符画的亮度天花板只有 80/255 上下，白天要真的亮，只能在字符底下垫一层。 */
      let dayFillAlpha = 0;
      let dayFillTop = '#000000';
      let dayFillBot = '#000000';
      let dayFillSeaTop = '#000000';
      let dayFillSeaMid = '#000000';
      let dayFillSeaDeep = '#000000';
      /* 黄金时刻的天空要五段（靛 → 紫玫瑰 → 暮红 → 橙 → 亮黄）。
         mid 为 null 表示「不是黄金时刻」，渐变退回原来那两段 —— 少一次分支判断。 */
      let dayFillMid: string | null = null;
      let dayFillDusk = '#000000';
      let dayFillHor = '#000000';
      /* 日头那圈径向辉光的圆心（画布像素）与强度 */
      let glowX = 0;
      let glowY = 0;
      let sunGlow = 0;
      /* 黄金时刻的「生效程度」= 强度 × 天已经亮了多少（0..1），渐变曲线用它 */
      let goldMix = 0;
      /* 这一帧的黄金时刻强度，render() 画辉光配色时要用 */
      let goldWNow = 0;

      const plot = (x: number, y: number, b: number, h: number, s: number) => {
        if (!(x >= 0 && y >= 0 && x < cols && y < rows)) return;
        const idx = y * cols + x;
        if (b <= intensity[idx]) return;
        intensity[idx] = b;
        hueBuf[idx] = h;
        satBuf[idx] = s;
      };

      /**
       * 强制覆盖地画一格：亮度存成**负数**，render 里认这个符号。
       * 为什么需要它：plot 是「取最大值」，所以只有比背景更亮的东西才画得上去。
       * 而逆光的鸟剪影是**比亮天更暗**的 —— 用 plot 会被天整个吃掉。
       * 热气球也用它：不然球面上稍暗的那几格会被天光噪声咬出洞。
       */
      const plotOver = (x: number, y: number, b: number, h: number, s: number) => {
        if (!(x >= 0 && y >= 0 && x < cols && y < rows)) return;
        const idx = y * cols + x;
        intensity[idx] = -b;
        hueBuf[idx] = h;
        satBuf[idx] = s;
      };

      /**
       * 一个热气球：上宽下窄的球体 + 收颈 + 吊索 + 吊篮，全部按格现算。
       * 球体的纵向半径要**除以 aspect** —— 字符格是 7.2×12 的长方形，
       * 不补这一下，画出来会是一根竖着的长条，不是圆球。
       */
      /**
       * 一只热气球：球体 + 收颈 + 吊索 + 吊篮。
       * 球型与花纹都是**这一只自己的**（见 BALLOON_SHAPES 与 BalloonPattern），
       * 所以天上飘三只不会像三胞胎。
       * bodyH 要**除以 aspect** —— 字符格是 7.2×12 的长方形，
       * 不补这一下球体会被拉成一根竖条。
       */
      const drawBalloon = (cx: number, cy: number, bl: Balloon, alpha: number) => {
        const shape = BALLOON_SHAPES[bl.kind];
        const r = bl.r;
        const bodyH = (r / Math.max(1, aspect)) * shape.hMul;
        const x0 = Math.floor(cx - r - 1);
        const x1 = Math.ceil(cx + r + 1);
        const y0 = Math.floor(cy - bodyH - 1);
        const y1 = Math.ceil(cy + bodyH * 2.3 + 1);
        for (let y = y0; y <= y1; y += 1) {
          const v = (y - cy) / bodyH;
          for (let x = x0; x <= x1; x += 1) {
            const u = (x - cx) / r;
            /* 球体轮廓：赤道最宽，往下按 taper 收。taper 为负就是往下**张**，
               成了梨形。幂次 1.6 让收口集中在最下面几格，上半球几乎是个正圆。 */
            const shrink = 1 - shape.taper * Math.pow(Math.max(0, v), 1.6);
            if (v >= -1 && v <= 1 && Math.abs(u) <= shrink) {
              const d = Math.hypot(u / Math.max(0.2, shrink), v);
              const rim = smoothstep(1, 0.7, d); // 边缘收一圈暗，圆盘才有体积感
              const lit = 0.5 + 0.42 * (1 - Math.abs(u) * 0.55) * (1 - Math.max(0, v) * 0.3);
              /* 花纹：分瓣 / 横带 / 棋盘 / 素色 / 顶冠。
                 疏密（sf）和相位（sp）也是每只自己的，同一个花纹也不会撞。 */
              let hue = bl.hue;
              if (bl.pattern === 'hstripe') {
                if (Math.sin(v * bl.sf + bl.sp) > 0) hue = bl.hue2;
              } else if (bl.pattern === 'check') {
                if (Math.sin(u * bl.sf + bl.sp) * Math.sin(v * bl.sf * 0.9 + bl.sp) > 0) {
                  hue = bl.hue2;
                }
              } else if (bl.pattern === 'crown') {
                if (v < -0.5) hue = bl.hue2; // 只有顶上那一圈是另一个颜色
              } else if (bl.pattern !== 'plain') {
                if (Math.sin(u * bl.sf + bl.sp) > 0) hue = bl.hue2;
              }
              plotOver(x, y, clamp(lit * rim * alpha, 0, 1), hue, 0.6);
              continue;
            }
            // 收颈 → 吊索 → 吊篮（宽度跟着球型走：梨形的篮子也大一号）
            const neck = Math.abs(u) < shape.neckW && v > 1 && v < 1.3;
            const rope = Math.abs(Math.abs(u) - shape.ropeW) < 0.07 && v >= 1.3 && v <= 1.52;
            const basket = Math.abs(u) < shape.basketW && v > 1.52 && v < 2.1;
            if (neck || rope || basket) {
              const b = (basket ? 0.62 : neck ? 0.5 : 0.38) * alpha;
              plotOver(x, y, b, 0.09, 0.52);
            }
          }
        }
      };

      /**
       * 一条帆船。船体 + 桅杆 + 帆，全部按格现算。
       * 纵向尺寸同样要**除以 aspect** —— 字符格是 7.2×12 的长方形，
       * 不补这一下，桅杆会拉成一根细长的竖条，帆也立不起来。
       * cy 是甲板所在的行；tilt 是随浪的上下起伏（近处的船晃得明显）。
       * 船型见 BOAT_SHAPES：单桅三角帆 / 单桅方帆 / 双桅 / 小艇。
       *
       * 配色是试出来的：第一版帆用青灰（跟海一个色系），整条船糊在海里看不见。
       * 现在靠**冷暖 + 明暗**立起来 —— 帆是暖白（偏米黄），船体是深棕，
       * 压在一片青蓝的海上才认得出是条船。
       */
      const drawBoat = (
        cx: number,
        cy: number,
        s: number,
        dir: number,
        alpha: number,
        tilt: number,
        goldW = 0,
        kind: BoatKind = 'sloop',
      ) => {
        const asp = Math.max(1, aspect);
        const deck = Math.round(cy + tilt);
        const k = BOAT_SHAPES[kind];
        /* 黄金时刻：船体与帆一起往深橙里压，帆的饱和度从「近乎白」抬到 0.48 ——
           白帆在正午是白的，在夕阳下是被点着的一片橙。 */
        const hullHue = lerp(0.055, 0.035, goldW);
        const hullSat = lerp(0.62, 0.8, goldW);
        const sailHue = lerp(0.1, 0.06, goldW);
        const sailSat = lerp(0.16, 0.48, goldW);
        const sailLit = alpha * lerp(1, 0.9, goldW);
        /* ⚠️ 列坐标必须先取整。plotOver 内部是 `intensity[y * cols + x]`，
           拿浮点 x 去索引 Float32Array 是**静默失败**（不报错、也不写入），
           整条船会一个字符都画不出来 —— 第一版就栽在这儿。 */
        const cxi = Math.round(cx);
        const S = Math.max(2, s * k.hull); // 船体半长

        // 船体：中间吃水深、两头翘起的一条弧
        for (let dx = -S; dx <= S; dx += 1) {
          const f = 1 - (dx / S) * (dx / S);
          const depth = Math.max(0, Math.round((S * k.depth * f) / asp));
          for (let j = 0; j <= depth; j += 1) {
            plotOver(cxi + Math.round(dx), deck + j, (0.44 - 0.08 * j) * alpha, hullHue, hullSat);
          }
        }

        // 桅杆：从甲板往上。双桅船前后各一根
        const mastH = Math.max(2, Math.round((S * k.mast) / asp));
        const mastAt = k.masts === 2 ? [-0.44, 0.36] : [0];
        for (const off of mastAt) {
          const mx = cxi + Math.round(off * S);
          for (let j = 1; j <= mastH; j += 1) {
            plotOver(mx, deck - j, 0.4 * alpha, hullHue, lerp(0.45, 0.6, goldW));
          }
        }

        if (kind === 'square') {
          /* 方帆：上窄下宽的**梯形**。底边压在甲板上、顶边收掉三分之一 ——
             不是方布也不是三角，和三角帆一眼就能分开。 */
          for (let j = 1; j <= mastH; j += 1) {
            const y = deck - j;
            const t = j / mastH;
            const half = Math.max(1, Math.round(S * k.main * (1 - 0.34 * t)));
            for (let d = -half; d <= half; d += 1) {
              plotOver(cxi + d, y, (1.02 - 0.035 * Math.abs(d)) * sailLit, sailHue, sailSat);
            }
          }
        } else if (kind === 'schooner') {
          /* 双桅：两根桅杆各挂一片三角帆，前桅朝船头、后桅朝船尾 ——
             两片帆中间留一条缝，和单桅那一片大三角完全不同。 */
          for (let i = 0; i < 2; i += 1) {
            const mx = cxi + Math.round(mastAt[i] * S);
            const h = Math.max(2, Math.round(mastH * (i === 0 ? 1 : 0.84)));
            const side = i === 0 ? -dir : dir;
            for (let j = 1; j <= h; j += 1) {
              const y = deck - j;
              const w = Math.max(1, Math.round((S * k.main * (h - j)) / h));
              for (let d = 1; d <= w; d += 1) {
                plotOver(mx + side * d, y, (1 - 0.04 * d) * sailLit, sailHue, sailSat);
              }
            }
          }
        } else {
          // sloop / dinghy：一片三角主帆；sloop 另加一片小前帆
          for (let j = 1; j <= mastH; j += 1) {
            const y = deck - j;
            const w = Math.max(1, Math.round((S * k.main * (mastH - j)) / mastH));
            for (let d = 1; d <= w; d += 1) {
              plotOver(cxi + dir * d, y, (1.06 - 0.04 * d) * sailLit, sailHue, sailSat);
            }
          }
          if (k.jib > 0) {
            const jibH = Math.max(1, Math.round(mastH * 0.7));
            for (let j = 1; j <= jibH; j += 1) {
              const y = deck - j;
              const w = Math.max(1, Math.round((S * k.jib * (jibH - j)) / jibH));
              for (let d = 1; d <= w; d += 1) {
                plotOver(cxi - dir * d, y, (0.94 - 0.04 * d) * sailLit, sailHue, sailSat * 1.2);
              }
            }
          }
        }
      };

      /** 星星只在初始化时撒一次，横向位置交给漂移，之后不动的只有它们的呼吸。 */
      const buildStars = () => {
        const count = Math.round(Math.min(340, cols * 1.35));
        stars = [];
        for (let i = 0; i < count; i += 1) {
          // 大多数星星都很暗很远，亮的只有少数几颗 —— 密度一平均就变成噪点
          const z = Math.pow(Math.random(), 1.5);
          const warm = Math.random() < 0.22;
          stars.push({
            x: Math.random() * cols,
            y: Math.random() * Math.max(2, bandTop * 0.98),
            z,
            hue: warm ? 0.09 + Math.random() * 0.05 : 0.52 + Math.random() * 0.1,
            sat: warm ? 0.45 : 0.08 + Math.random() * 0.34,
            phase: Math.random() * TAU,
            tw: 0.3 + Math.random() * 0.8,
          });
        }
      };

      /** 流星带里的流星：轨道、速度、相位在初始化时一次定死 */
      const buildMeteors = () => {
        const count = Math.round(clamp(cols * 0.11, 8, 22));
        meteors = [];
        for (let i = 0; i < count; i += 1) {
          const warm = Math.random() < 0.24;
          meteors.push({
            x: Math.random() * cols,
            par: 0.55 + Math.random() * 0.45, // 跟着天空漂移的系数
            speed: 0.34 + Math.random() * 0.5, // 每秒走完轨道全长的几分之一
            phase: Math.random(), // 各自的相位：免得一起掉下来
            len: 4 + Math.floor(Math.random() * 7), // 尾巴长度（行）
            slant: 2 + Math.random() * 8, // 整段下落里向左偏多少列
            gain: 0.76 + Math.random() * 0.34,
            hue: warm ? 0.08 + Math.random() * 0.05 : 0.5 + Math.random() * 0.1,
            sat: warm ? 0.5 : 0.14 + Math.random() * 0.3,
          });
        }
      };

      /** 洗牌：把一个数组原地打乱，用来保证同屏的对象彼此不重复 */
      const shuffle = <T,>(list: T[]): T[] => {
        const out = list.slice();
        for (let i = out.length - 1; i > 0; i -= 1) {
          const j = Math.floor(Math.random() * (i + 1));
          const tmp = out[i];
          out[i] = out[j];
          out[j] = tmp;
        }
        return out;
      };

      /** 热气球：白天才放出来，数量很少 —— 天上飘十几个气球就成了游乐园 */
      const buildBalloons = () => {
        balloons = [];
        const count = Math.round(clamp(cols * 0.014, 2, 4));
        /* 球型与花纹都从「袋子」里抽：同屏的气球一定拿到不同的球型，
           花纹再各自随机 —— 三只气球不会长得一样。 */
        const kinds = shuffle<BalloonKind>(['round', 'tall', 'pear', 'squat']);
        const patterns: BalloonPattern[] = ['vstripe', 'hstripe', 'plain', 'check', 'crown'];
        for (let i = 0; i < count; i += 1) {
          const warm = Math.random() < 0.72;
          balloons.push({
            x: Math.random() * cols,
            y: bandTop * (0.2 + Math.random() * 0.42),
            /* 球体的半径。原来取 cols * 0.019（约 3.4 格宽），球型之间的差别
               只有两三个字符，等于白做 —— 球型要看得出来，尺寸就得先够。 */
            r: Math.max(3, cols * 0.026) * (0.82 + Math.random() * 0.42),
            // 每秒走多少列：横穿一屏要几分钟 —— 气球本来就是慢慢飘的
            speed: (0.7 + Math.random() * 0.6) * cols * 0.004,
            hue: warm ? 0.015 + Math.random() * 0.055 : 0.54 + Math.random() * 0.07,
            hue2: warm ? 0.11 + Math.random() * 0.04 : 0.09,
            bob: Math.random() * TAU,
            kind: kinds[i % kinds.length],
            pattern: patterns[Math.floor(Math.random() * patterns.length)],
            sf: 3.2 + Math.random() * 3.4, // 条纹疏密
            sp: Math.random() * TAU, // 条纹相位
          });
        }
      };

      /** 鸟群：几群，每群排成一个松散的 V —— 一只领头，两侧依次拉开 */
      const buildFlocks = () => {
        flocks = [];
        const count = Math.round(clamp(cols * 0.011, 1, 3));
        for (let i = 0; i < count; i += 1) {
          const n = 5 + Math.floor(Math.random() * 5);
          const birds: Bird[] = [];
          for (let k = 0; k < n; k += 1) {
            const side = k % 2 === 0 ? -1 : 1;
            const rank = Math.floor(k / 2) + 1;
            birds.push({
              // 间距要够开：一只鸟本身就占三格，挤在一起会糊成一团黑
              dx: side * rank * (1.7 + Math.random() * 0.9),
              dy: rank * (0.8 + Math.random() * 0.5) + (Math.random() - 0.5) * 0.6,
              phase: Math.random() * TAU,
              flap: 3.4 + Math.random() * 2.4, // 扇翅快慢，每只略不同才不像复制品
            });
          }
          flocks.push({
            x: Math.random() * cols,
            y: bandTop * (0.1 + Math.random() * 0.52),
            // 比气球快得多：鸟要看出「在飞」，气球只要看出「在飘」
            speed: (0.9 + Math.random() * 0.7) * cols * 0.017,
            bob: Math.random() * TAU,
            birds,
          });
        }
      };

      /** 帆船：也是白天的东西。数量很少 —— 海面上一排船就成港口了 */
      const buildBoats = () => {
        boats = [];
        const count = Math.round(clamp(cols * 0.016, 2, 5));
        // 船型也从袋子里抽：同屏的船一定不同型（单桅三角帆 / 方帆 / 双桅 / 小艇）
        const kinds = shuffle<BoatKind>(['sloop', 'square', 'schooner', 'dinghy']);
        for (let i = 0; i < count; i += 1) {
          // 深度铺开：远的贴着地平线，近的贴着画面底
          const v = 0.12 + Math.random() * 0.72;
          boats.push({
            x: Math.random() * cols,
            v,
            // 越近看着走得越快（透视），方向各半
            speed: (0.2 + Math.random() * 0.35) * cols * 0.004 * (0.35 + v * 1.5),
            dir: Math.random() < 0.5 ? -1 : 1,
            phase: Math.random() * TAU,
            kind: kinds[i % kinds.length],
          });
        }
      };

      /** 量出一格字符的真实尺寸，再把视口切成网格 */
      const build = () => {
        if (!canvas || !ctx) return;

        W = Math.max(320, Math.round(window.innerWidth));
        H = Math.max(400, Math.round(window.innerHeight));
        const dpr = clamp(window.devicePixelRatio || 1, 1, 1.75);

        // 字符密度：一列约 7.2px，比上一版密了将近三倍。
        // 上限 220 列是给超宽屏兜底的 —— 实测这个密度每帧只要几毫秒，
        // 真掉帧了还有 considerDegrade() 在下面接着。
        const targetCols = Math.round(clamp((W / 7.2) * quality, 54, 220));

        // 用「十个 M 的宽度」反推字号，保证列宽正好是一个等宽字符的宽度。
        let fontSize = Math.max(9, W / (targetCols * 0.6));
        for (let i = 0; i < 3; i += 1) {
          ctx.font = `${fontSize}px ${FONT}`;
          const adv = ctx.measureText('MMMMMMMMMM').width / 10;
          if (!adv || !Number.isFinite(adv)) break;
          fontSize = Math.max(9, fontSize * (W / targetCols / adv));
        }
        fontSize = Math.max(9, Math.round(fontSize * 2) / 2);

        ctx.font = `${fontSize}px ${FONT}`;
        const adv = ctx.measureText('MMMMMMMMMM').width / 10;
        cellW = adv > 0.5 ? adv : fontSize * 0.6;
        cellH = Math.round(fontSize * 1.02);

        cols = Math.max(24, Math.ceil(W / cellW));
        rows = Math.max(20, Math.ceil(H / cellH));
        aspect = cellH / cellW;

        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        canvas.style.width = `${W}px`;
        canvas.style.height = `${H}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.font = `${fontSize}px ${FONT}`;
        ctx.textAlign = 'left';
        ctx.textBaseline = 'top';

        intensity = new Float32Array(cols * rows);
        hueBuf = new Float32Array(cols * rows);
        satBuf = new Float32Array(cols * rows);

        // 三段分界：上面是宇宙，中间是流星带，下面是大海
        bandTop = Math.round(rows * SKY_EDGE);
        horizon = Math.round(rows * SEA_EDGE);
        /* 月亮的**大小**和视口有关，所以在这里定；**位置**和本地时间有关，
           每帧在 drawScene 里算 —— 两者分开，窗口一改大小位置也不会跳。 */
        moonR = Math.max(3.2, Math.min(cols * 0.032, bandTop * 0.24));

        buildStars();
        buildMeteors();
        buildBalloons();
        buildFlocks();
        buildBoats();
      };

      /** 把这一帧的「星海」写进 intensity / hue / sat 三个缓冲 */
      const drawScene = (t: number) => {
        intensity.fill(0);

        /* 整片天空向左漂了多少列。星云、星、月都从这里取位移：
           同一个 drift 配不同的系数，就是一层一层的视差。

           现在它由两部分合成：
             nightU * SKY_NIGHT_SPAN —— 天球跟着夜一起转，起点由本地时间决定
             t * SKY_DRIFT           —— 原来那点自转，保证画面始终是活的 */
        const nightU = nightPhase();
        const drift = nightU * cols * SKY_NIGHT_SPAN + t * SKY_DRIFT * cols;

        /* ---------- 月亮的位置：完全由本地时间决定 ----------
           u = 0 东边升起 → 0.5 天顶 → 1 西边落下，横坐标线性、纵坐标走一道弧。
           纵坐标夹在「贴顶」与「贴地平线」之间，所以升起和落下时它都压得很低。

           淡入淡出**只看横坐标，不看白天/黑夜**：横坐标是连续的，所以 06:00
           那一刻不会有「啪」地一跳；白天 moonXs 已经跑到画面外，fade 自然是 0。 */
        const moonArc = nightU < 1 ? Math.pow(Math.sin(Math.PI * nightU), MOON_ARC_POW) : 0;
        const moonXs = cols * lerp(MOON_RISE_X, MOON_SET_X, nightU);
        const moonTopY = moonR * aspect + 1;
        const moonLowY = Math.max(moonTopY, bandTop - moonR * aspect - 1);
        const moonY = lerp(moonLowY, moonTopY, moonArc);
        /* 窗口取窄一点：月亮升起来之后很快就该看得见了，淡得太久等于没升。
           同时两端必须淡到 0（升起点在画面外），否则 18:00 那一帧会突然冒出来。 */
        const moonWin = Math.max(moonR * 0.7, cols * 0.015);
        const moonFade =
          smoothstep(0, moonWin, moonXs) * smoothstep(0, moonWin, cols - moonXs);

        /* ---------- 太阳的位置：和月亮同一条轨道，只是走的是白天那半圈 ----------
           d = 0 日出 → 0.5 天顶 → 1 日落。两者在 06:00 / 18:00 都贴着地平线，
           所以「月亮刚落下、太阳刚升起」是同一套坐标算出来的，接得上。 */
        const isDay = nightU >= 1;
        const dayPhase = isDay ? nightU - 1 : 0;
        const dayness = isDay ? Math.pow(Math.sin(Math.PI * dayPhase), DAY_CURVE) : 0;
        const sunArc = isDay ? Math.pow(Math.sin(Math.PI * dayPhase), MOON_ARC_POW) : 0;

        /* ---------- 黄金时刻的强度：只看「离地平线多近」 ----------
           日出段 [0, GOLD_SPAN] 由 1 淡到 0，日落段 [1-GOLD_SPAN, 1] 由 0 淡到 1，
           两段取大。日落的 dayPhase 是 1（贴地平线），所以 1 - smoothstep 那一支
           在 17:59 会走到 1；两个边界都是 0，和正午那一段接得上，不会跳。 */
        const goldW =
          goldArg === null || !isDay
            ? 0
            : goldArg === 'auto'
              ? Math.max(
                  1 - smoothstep(0, GOLD_SPAN, dayPhase),
                  smoothstep(1 - GOLD_SPAN, 1, dayPhase),
                )
              : goldArg;

        /* 这一帧的配色与日面半径。goldW = 0 时 tone 就是 DAY_TONE 本身 */
        const tone = toneAt(goldW);
        const gain = toneGain(tone);
        const sunR = moonR * lerp(1, GOLD_SUN_R, goldW);
        const sunXs = cols * lerp(MOON_RISE_X, MOON_SET_X, dayPhase);
        const sunY = lerp(moonLowY, moonTopY, sunArc);
        const sunFade = isDay
          ? smoothstep(0, moonWin, sunXs) * smoothstep(0, moonWin, cols - sunXs)
          : 0;
        /* 水面上那条光路只有一个光源：白天跟太阳、夜里跟月亮。
           切换点上两者都是 0（月亮早跑出画面、太阳刚露头），所以不会跳。 */
        const lightXs = isDay ? sunXs : moonXs;
        const lightFade = isDay ? sunFade : moonFade;
        /* 星星、星云、流星按天光一起退场。
           黄金时刻再压一道：地平线烧起来的时候头顶还有满天亮星，那是错的
           —— 暮色里最先看不见的就是星星。goldW = 0 时这个因子恒等于 1。 */
        const nightGain = (1 - dayness) * (1 - 0.85 * goldW);

        /* 底色渐变：透明度跟着 dayness 走，夜里是 0（等于没垫）。
           黄金时刻再抬一档：日出日落时地平线那一带本来就极亮，而 dayness 是
           按「太阳高度」算的、此刻还很低 —— 不补这一档，整片天会闷成一层灰褐色
           （橙色的亮度天生比暖白低，同样的透明度铺上去要暗一大截）。
           ⚠️ 补的量必须**慢慢起**：dayness 本身在日出后十分钟里就从 0 爬到 0.18，
           直接乘一个「亮了就补满」的开关，06:00 到 06:10 之间画面会从全黑跳到全亮，
           看着就是一刀切。所以这里的斜坡从 0.05 拉到 0.34 ——
           既压住那一刻的硬切，又保证 06:25 之后该亮的都亮到位。 */
        /* 底色渐变：天空现在是**纯色**（字符层已经撤掉），所以这层要铺满铺实。
           透明度就是「天亮了没有」：夜里是 0，让 CSS 那层夜空渐变接管。
           斜坡从 0.02 拉到 0.32 —— dayness 在日出后十分钟里就从 0 爬到 0.18，
           斜坡太陡会让 06:00→06:05 之间整片天从黑跳到亮（实测平均亮度 27→78）。
           黄金时刻再抬一档：橙色的亮度天生比暖白低，不补会闷成一层灰褐色。 */
        const skySolid = smoothstep(0.02, 0.32, dayness);
        goldMix = goldW * smoothstep(0.05, 0.34, dayness);
        dayFillAlpha = Math.max(skySolid, 0.95 * goldMix);
        dayFillTop = tone.fillTop;
        dayFillBot = tone.fillBot;
        /* 黄金时刻的天空要五段。goldW = 0 时 mid 保持 null，
           渐变退回「天顶深蓝 → 地平线暖白」那一条直线。 */
        dayFillMid = goldW > 0.004 ? mixHex(GOLD_SKY_MID, tone.fillBot, goldW) : null;
        dayFillDusk = goldW > 0.004 ? mixHex(GOLD_SKY_DUSK, tone.fillBot, goldW) : tone.fillBot;
        dayFillHor = goldW > 0.004 ? mixHex(DAY_TONE.fillBot, GOLD_SKY_HOR, goldW) : tone.fillBot;
        /* 日头那一圈径向辉光。天空改成纯色之后，日头周围的光晕不能再靠
           「天光那一层的字符亮度」撑起来 —— 得由这层径向渐变自己画。
           白天是一圈白热的柔光，黄金时刻换成更大、更暖、更铺得开的一团。 */
        glowX = sunXs;
        glowY = sunY;
        sunGlow = smoothstep(0.03, 0.28, dayness) * lerp(0.5, 0.62, goldMix);
        goldWNow = goldW;
        /* 海面顶上接住地平线的颜色（那一片在反射天光），往下压到 seaDeep */
        dayFillSeaTop = dayFillHor;
        dayFillSeaMid = goldW > 0.004 ? mixHex(GOLD_SEA_MID, tone.seaDeep, goldW) : tone.seaDeep;
        dayFillSeaDeep = tone.seaDeep;

        /* 标题那圈暗色晕罩：天亮之后要淡到没有。
           天亮之后标题自己换成了深蓝，再压一层黑罩反而是把对比度拉低 ——
           深字配亮天本来就清楚，罩子该退场。只在变化超过 0.02 时才写 CSS 变量。

           ⚠️ 标题的深浅要跟**天空实际有多亮**走，不是跟 dayness 走。
           两者在日出日落时差得很远：06:20 的 dayness 才 0.26，可天已经被
           底色渐变铺到 0.9 了 —— 按 dayness 算出来的 toneDark 只有 0.29，
           浅青的字压在亮桃色的天上，实测对比度只有 1.85:1（读不清）。
           skySolid 就是「底色铺了多满」，拿它当标题的深浅才对得上。
           （noon / 深夜两端 skySolid 与原来的取值完全一致，那两档没变。） */
        const toneDark = Math.max(skySolid, smoothstep(0.1, 0.55, dayness)) * tone.titleDark;
        const haloAlpha = 0.93 * (1 - toneDark);
        const titleGlow = 0.38 * (1 - 0.9 * toneDark);
        if (Math.abs(haloAlpha - lastHalo) > 0.02) {
          lastHalo = haloAlpha;
          const root = document.documentElement.style;
          root.setProperty('--halo', haloAlpha.toFixed(3));
          root.setProperty('--title-glow', titleGlow.toFixed(3));
        }
        /* 标题配色跟着白天走；跨过一档才会真的重画（titleRedraw 内部会挡掉） */
        titleRedraw?.(toneDark);

        /* ---------- 0) 白天的天光：**不再画字符** ----------
           这一层原来是把天铺亮的字符场：一层平滑的亮度梯度去挑字符，
           再逐格抖动把行纹打断。远看就是一张均匀的网点 —— 密、重复、发乱。
           天空本来就该是一片干净的颜色，字符只该出现在**有东西的地方**。
           整片天现在交给 render() 里那条铺满的底色渐变；
           日头周围的光晕也一并交给径向渐变（linear 渐变按行铺，
           做不出「亮从日头向两边散开」）。

           顺带省掉一整层逐格计算：桌面 1440×900 下这里是 25 行 × 179 列。
           夜里 dayness = 0，这一段本来就不走。 */

        /* ---------- 1) 星云：天空的底色，紫到品红，跟着天一起往左漂 ---------- */
        for (let y = 0; y < bandTop && nightGain > 0.004; y += 1) {
          // 阈值拉高：噪声只有最高的那一部分才结成云，天空大部分留黑 —— 太空本来就该是空的
          const nfade =
            smoothstep(0, bandTop * 0.1, y) * (1 - 0.7 * smoothstep(bandTop * 0.78, bandTop, y));
          if (nfade <= 0.002) continue;
          const ny = y * 0.042;
          for (let x = 0; x < cols; x += 1) {
            // 云是最远的一层，只走星星三分之一的位移
            const nx = (x + drift * 0.36) * 0.023;
            const a = smoothstep(0.6, 1, fbm(nx, ny));
            if (a <= 0.02) continue;
            const idx = y * cols + x;
            const cloud = a * nfade * 0.4 * nightGain;
            if (cloud <= intensity[idx]) continue;
            intensity[idx] = cloud;
            hueBuf[idx] = lerp(0.87, 0.73, smoothstep(0.35, 0.85, valueNoise(nx * 1.9 + 5.5, ny * 1.9)));
            satBuf[idx] = 0.56;
          }
        }

        /* ---------- 2) 流星带：**不再画字符** ----------
           原来这里是一层「大气的厚度」：越往下越浓的雾，靠几十行暗格叠出来。
           和天光层一样，它是一张铺满的网，不是形状。
           现在这段高度由底色渐变自己从 bandTop 过渡到 horizon，
           只留下最下面那条**地平线光带**（第 6 段）—— 那一条有形状、有明暗，
           是画面里真正需要的一笔。 */

        /* ---------- 3) 流星：一个个字符从带顶落向地平线 ----------
           每颗流星有自己的轨道和周期，亮度走一条 sin 曲线 —— 进场时慢慢亮起来，
           中段最亮，然后一路暗下去熄灭，尾巴在后面一级一级变淡。
           位置全是时间的函数，没有任何逐帧随机数（那会变成闪烁，就又成噪音了）。 */
        const bandH = horizon - bandTop + 1;
        for (let i = 0; i < meteors.length && nightGain > 0.004; i += 1) {
          const m = meteors[i];
          const p = (t * m.speed + m.phase) % 1;
          const headY = bandTop - m.len + p * (bandH + m.len);
          // 亮度只跟「掉到带里的哪个位置」有关，跟尾巴多长无关：
          // prog=0 刚进带顶（暗）→ 0.5 中段（最亮）→ 1 到地平线（又暗下去）。
          const prog = (headY - bandTop) / bandH;
          if (prog <= 0 || prog >= 1) continue;
          const env = Math.pow(Math.sin(prog * Math.PI), 1.25);
          const mx = wrap(m.x - drift * m.par - p * m.slant, cols);
          for (let k = 0; k < m.len; k += 1) {
            const y = Math.round(headY - k);
            if (y < bandTop || y >= horizon) continue;
            const b = env * Math.pow(1 - k / m.len, 2.2) * m.gain * nightGain;
            if (b <= 0.05) continue;
            // 尾巴往右上拖，因为它是在往左下掉
            plot(Math.round(mx + k * 0.24), y, b, m.hue, m.sat);
          }
        }

        /* ---------- 4) 星星：越近越亮的点，加一点点很慢的呼吸 ---------- */
        for (let i = 0; i < stars.length && nightGain > 0.004; i += 1) {
          const s = stars[i];
          // 位移按 z 分档：近的（z 大）跑得快，远的几乎黏在星云上 —— 第二层视差
          const sx = wrap(s.x - drift * (0.5 + 1.05 * s.z), cols);
          // 走到两端就淡进淡出，否则绕回来那一瞬间会「啪」地冒出一颗
          const edge = smoothstep(0, 5, sx) * smoothstep(0, 5, cols - sx);
          if (edge <= 0.02) continue;
          const twinkle = 0.72 + 0.28 * Math.sin(t * s.tw + s.phase);
          const fade = 1 - 0.82 * smoothstep(bandTop * 0.72, bandTop, s.y);
          const b = (0.06 + 0.92 * s.z) * twinkle * fade * edge * nightGain;
          if (b <= 0.05) continue;
          const xi = Math.round(sx);
          const yi = Math.round(s.y);
          plot(xi, yi, b, s.hue, s.sat);
          if (s.z > 0.68) {
            const halo = b * 0.3;
            plot(xi + 1, yi, halo, s.hue, s.sat);
            plot(xi - 1, yi, halo, s.hue, s.sat);
            plot(xi, yi + 1, halo * 0.9, s.hue, s.sat);
            plot(xi, yi - 1, halo * 0.9, s.hue, s.sat);
          }
          if (s.z > 0.9) {
            const flare = b * 0.2;
            plot(xi + 2, yi, flare, s.hue, s.sat);
            plot(xi - 2, yi, flare, s.hue, s.sat);
            plot(xi, yi + 2, flare, s.hue, s.sat);
            plot(xi, yi - 2, flare, s.hue, s.sat);
          }
        }

        /* ---------- 5) 月亮：画面唯一的实体，也是海面那条光路的源头 ----------
           位置（moonXs / moonY / moonFade）已经在上面按本地时间算好了，这里只负责画。 */
        const y0 = Math.max(0, Math.floor(moonY - moonR * aspect - 2));
        const y1 = Math.min(rows - 1, Math.ceil(moonY + moonR * aspect + 2));
        const x0 = Math.max(0, Math.floor(moonXs - moonR - 2));
        const x1 = Math.min(cols - 1, Math.ceil(moonXs + moonR + 2));
        for (let y = y0; y <= y1; y += 1) {
          for (let x = x0; x <= x1; x += 1) {
            const d = Math.hypot(x - moonXs, (y - moonY) * aspect) / moonR;
            if (d <= 1) {
              // 中心亮、边缘收一点 = 球的体积感；叠一层低频噪声做出月海的斑驳。
              // 亮度刻意压在 1 以下，让圆盘里有 # % @ 的层次，而不是糊成一块白。
              const sphere = 0.86 + 0.26 * (1 - d * d);
              const mare = 0.84 + 0.3 * valueNoise(x * 0.42 + 11.7, y * 0.42 + 4.3);
              const rim = smoothstep(1, 0.86, d);
              plot(x, y, 1.04 * sphere * mare * rim * moonFade, 0.12, 0.26);
            } else if (d < 1.5) {
              const g = Math.pow(1 - (d - 1) / 0.5, 2.2) * 0.2 * moonFade;
              if (g > 0.02) plot(x, y, g, 0.125, 0.4);
            }
          }
        }

        /* ---------- 5b) 太阳：白天的光源，和月亮同一条轨道 ----------
           颜色要的是**高饱和 + 高亮度**，不是低饱和。
           调色板的亮度上限只有 80%，低饱和的暖色落在这里就是一块土褐色的盘子；
           hsl(45, 100%, 69%) 才是那种金黄 —— 靠饱和度把它顶上去。

           黄金时刻变三件事：
             · 半径 ×1.55 —— 贴着地平线的一轮日面看起来就是更大（大气折射 + 参照效应）。
               放大的是半径，圆心和轨迹不动，所以升落时刻一点没变。
            · 色相从金黄压到深橙，外圈的辉光更宽更亮。
              但**中心仍然要留一点「白热」**：调色板的亮度上限只有 80%，
              一整轮都是高饱和的橙，摆在同样橙色的天空里就糊成一团、看不出是太阳。
              中心降饱和（0.30）拿到接近奶白的那一格，边缘留满饱和的橙，
              圆盘内部才有层次，也才压得住背景。 */        if (sunFade > 0.01) {
          /* 中心偏黄白、边缘深橙 —— 两个色相在圆盘里插值，
             所以低垂的太阳既烧得起来，圆心又不会被橙色背景吞掉。 */
          const sunHue = lerp(0.125, GOLD_SUN_HUE, goldW);
          const sunHueCore = lerp(0.125, 0.105, goldW);
          const satEdge = lerp(0.98, 1, goldW);
          const satCore = lerp(0.98 - 0.42, 0.18, goldW);
          const sy0 = Math.max(0, Math.floor(sunY - sunR * aspect - 2));
          const sy1 = Math.min(rows - 1, Math.ceil(sunY + sunR * aspect + 2));
          const sx0 = Math.max(0, Math.floor(sunXs - sunR - 2));
          const sx1 = Math.min(cols - 1, Math.ceil(sunXs + sunR + 2));
          for (let y = sy0; y <= sy1; y += 1) {
            for (let x = sx0; x <= sx1; x += 1) {
              const d = Math.hypot(x - sunXs, (y - sunY) * aspect) / sunR;
              if (d <= 1) {
                /* 中心偏白、边缘偏金：亮度被调色板压在 80% 以下，
                   「白热」只能靠**降饱和**做 —— 白天中心 0.56、边缘 0.98。 */
                const core = 1 - d * d;
                plot(
                  x,
                  y,
                  1.08 * (0.86 + 0.24 * core) * sunFade,
                  sunHue + (sunHueCore - sunHue) * core,
                  satEdge - (satEdge - satCore) * core,
                );
              } else if (d < 1.95) {
                const g = Math.pow(1 - (d - 1) / 0.95, 2.2) * lerp(0.5, 0.8, goldW) * sunFade;
                if (g > 0.02) plot(x, y, g, lerp(0.1, 0.055, goldW), lerp(0.46, 0.74, goldW));
              }
            }
          }
        }

        /* ---------- 6) 地平线：流星带与海的分界，也是纵深的最远处 ---------- */
        for (let y = Math.max(0, horizon - 5); y <= Math.min(rows - 1, horizon + 4); y += 1) {
          const g = Math.exp(-Math.pow((y - horizon - 0.2) / 0.95, 2));
          if (g < 0.01) continue;
          const above = clamp((horizon - y) / 5, 0, 1);
          /* 白天这条光带跟着天光一起抬起来，并往暖里偏 —— 夜里那条是冷青的。
             暖的那一头同样要先把饱和度压掉，不然色相从青走到暖会经过绿色。
             黄金时刻把它整个烧起来：亮度翻倍、色相推到深橙、饱和度拉到 0.8。 */
          const glow = g * lerp(0.66, 0.36, above) + g * dayness * gain * lerp(0.2, 0.62, goldW);
          const nightH = lerp(0.505, 0.77, above * 0.85);
          const [dayH, dayS] = warmBlend(0.565, 0.34, tone.warm, tone.warmHue, tone.warmSat);
          /* ⚠️ 色相只能**往暖的那一头降**：青 0.505 → 橙 0.042 的中点是
             0.27 ≈ 97°，那是绿色。白天那一档 warmSat 只有 0.22，绿被低饱和压住
             看不出来；黄金时刻要烧起来，一插就露出一条绿带。
             所以黄金时刻的色相直接取 tone.warmHue，按 goldW 挪过去 ——
             从 0.40 一路降到 0.04 走的是黄 → 橙，不经过绿。 */
          const h = lerp(lerp(nightH, dayH, dayness * 0.8), tone.warmHue, goldW);
          const s = lerp(lerp(0.42, 0.56, above), lerp(dayS, 0.85, goldW), dayness);
          for (let x = 0; x < cols; x += 1) {
            // 沿线明暗不均，才像一条被水汽切碎的光，而不是拿尺子画的一根亮线
            const mod =
              valueNoise(x * 0.14 + 3.1, y * 0.9) * 0.65 + valueNoise(x * 0.05 + 31.7, y * 0.4) * 0.35;
            plot(x, y, glow * (0.35 + 0.85 * mod), h, s);
          }
        }

        /* ---------- 7) 海面：透视压缩的浪 + 月光碎成的一条路 ---------- */
        const seaRows = rows - horizon;
        /* 浪线沿「距离」方向排布，而不是沿屏幕方向。
           近处的浪一波要占十几行，远处的浪一行就好几波 —— 这种疏密差就是纵深感本身。
           频率随 v 线性收窄（而不是用 1/v），远处的波纹才不会密到糊成一片噪点。
           相位只跟 y 走，x 上只留一点很轻的扰动，浪线才是连贯的横线而不是一堆散点。 */
        let wavePhi = 0;
        for (let y = horizon; y < rows; y += 1) {
          const v = (y - horizon + 1) / seaRows; // 0 = 最远（地平线），1 = 最近（画面底部）
          const near = Math.pow(v, 1.6);
          wavePhi += 0.42 + 1.55 * Math.pow(1 - v, 1.6); // 每行推进的相位：远处快、近处慢

          const drift = t * (0.5 + 1.05 * near);
          const vseed = valueNoise(y * 0.41, 7.7) * TAU;
          const haze = Math.exp(-v * 4.2); // 远处被地平线的光雾化
          // 浪与浪之间的水面压得很暗：对比度越高，越像一片有深度的水
          const band =
            (0.02 + 0.26 * haze) * (0.75 + 0.25 * Math.sin(v * 9 - t * 0.45)) * (1 - 0.5 * near) +
            dayness * tone.sea * (0.13 + 0.24 * haze); // 白天整片水面抬亮：亮天配黑海，反差会假
          /* 近处的蓝更深。黄金时刻整片水再往紫里沉一点（0.62 ≈ 223°，蓝紫）——
             被夕阳照着的水是「暖天 + 冷海」的对比，不是整片染橙。 */
          const rowHue = lerp(
            lerp(0.5 + 0.105 * near, 0.552, dayness * 0.65),
            0.62,
            goldW * 0.3,
          );
          const rowSat = lerp(
            0.34 + 0.3 * near,
            lerp(0.3, 0.22, tone.seaWarm),
            dayness * 0.6,
          ); // 近处更饱和，远处更灰；白天再退一点饱和，才像被阳光晒过的水
          // 那条光路越近越宽；太阳低垂时水面接住的是一整条路，不是一条线
          const spread = (4 + 28 * near) * lerp(1, 1.55, goldW);
          // 浪尖：近处又亮又宽；远处淡到只剩雾，免得高频波纹在远处糊成噪点
          const crestGain = (0.25 + 0.78 * near) * smoothstep(0, 0.28, v);

          for (let x = 0; x < cols; x += 1) {
            // 浪线自身的起伏（幅度压在 0.9 弧度以内，保证每一行都还能见到浪尖）
            const swell =
              0.55 * Math.sin(x * 0.075 + t * 0.42 + vseed) +
              0.35 * Math.sin(x * 0.031 - t * 0.26 + vseed * 1.7);
            // 相位 = 横向的轻微倾斜 + 沿距离推进的波 + 起伏
            const ang = x * 0.055 + wavePhi - drift + swell;
            // 起浪的门槛沿横向缓慢变化：浪线因此断断续续、成组出现，而不是一根根等宽横条
            const thr = 0.52 + 0.24 * Math.sin(x * 0.045 + t * 0.3 + vseed * 1.3);
            const crest = Math.pow(smoothstep(thr, 0.99, Math.sin(ang)), 1.3);
            // 细碎的波纹，只负责给浪尖加一点颗粒
            const chop = 0.5 + 0.5 * Math.sin(x * 0.55 + wavePhi * 2.4 - t * 1.6 + vseed);
            // 一片浪的大小有别：成组的浪头才不像拉出来的条纹
            const group = 0.5 + 0.5 * valueNoise(x * 0.045 + 17.3, vseed * 2.1);

            /* 那条光路钉在**光源**的横坐标上：夜里是月亮、白天是太阳。
               光源往左挪一格，水上碎光就跟一格；光源淡出时这条路一起淡掉，
               所以月亮「落下去」时海面是真的暗下来，太阳沉下去也一样。 */
            const dx = (x - lightXs) / spread;
            const shimmer = 0.5 + 0.5 * Math.sin(t * 1.7 + y * 0.55 + x * 0.11);
            const glitter =
              crest *
              Math.exp(-dx * dx * 3.6) *
              (0.18 + 0.72 * near) *
              shimmer *
              lightFade *
              (1 + dayness * lerp(0.55, 1.05, goldW)); // 日头比月亮烈，碎光也更碎更亮；贴着海面的日头最烈

            // 远处的光雾也要有横向的疏密，否则地平线下面会是一条平滑的色带
            const farPatch = 0.55 + 0.9 * valueNoise(x * 0.06 + 5.1, v * 26 + 11.3);
            const value =
              band * farPatch + crest * crestGain * (0.3 + 0.4 * chop + 0.5 * group) + glitter;
            if (value <= 0.012) continue;

            let h = rowHue;
            let s = rowSat;
            if (glitter > 0.03) {
              const g = clamp(glitter * 2.6, 0, 1);
              // 碎在浪尖上的光（月/日）都是暖的；黄金时刻这条路一直暖到深橙
              h = lerp(rowHue, lerp(0.125, 0.05, goldW), g);
              s = lerp(rowSat, lerp(lerp(0.36, 0.22, dayness), 0.92, goldW), g);
            }
            if (crest > 0.72) {
              s = lerp(s, 0.18, ((crest - 0.72) / 0.28) * 0.8); // 浪沫偏白
            }

            const idx = y * cols + x;
            if (value <= intensity[idx]) continue;
            intensity[idx] = value;
            hueBuf[idx] = h;
            satBuf[idx] = s;
          }
        }

        /* ---------- 8) 热气球与鸟群：白天才出来的活物 ----------
           放在最后画，因为它们走的是**强制覆盖**通道（见 plotOver）：
           鸟是逆光的剪影，比亮天更暗，用取最大值的 plot 会被天整个吃掉。
           两者都只在白天出现 —— 夜里 life 归零，整段跳过，代价为零。 */
        const life = smoothstep(0.1, 0.42, dayness);
        if (life > 0.01) {
          for (let i = 0; i < balloons.length; i += 1) {
            const bl = balloons[i];
            const pad = bl.r * 4; // 两端留出余量，好让它整个飘出去再绕回来
            const bx = wrap(bl.x - t * bl.speed + pad, cols + pad * 2) - pad;
            const by = bl.y + Math.sin(t * 0.24 + bl.bob) * 1.6;
            drawBalloon(bx, by, bl, life * lerp(1, 0.88, goldW));
          }
          for (let i = 0; i < flocks.length; i += 1) {
            const f = flocks[i];
            const fx = wrap(f.x - t * f.speed + 20, cols + 40) - 20;
            const fy = f.y + Math.sin(t * 0.33 + f.bob) * 1.4;
            for (let k = 0; k < f.birds.length; k += 1) {
              const bd = f.birds[k];
              const wing = Math.sin(t * bd.flap + bd.phase);
              const bx = Math.round(fx + bd.dx);
              const by = Math.round(fy + bd.dy + Math.sin(t * 1.1 + bd.phase) * 0.7);
              const lift = Math.round(wing * 1.2);
              /* 逆光剪影：亮度压到 0.4 上下（→ 疏的字形 + 低明度），饱和度也低。
                 第一版给到 0.6，结果只比天暗一点点，飞过去几乎看不见 ——
                 剪影要暗得干脆，哪怕字形稀一点。 */
              plotOver(bx - 1, by + lift, 0.38 * life, 0.58, 0.2);
              plotOver(bx + 1, by + lift, 0.38 * life, 0.58, 0.2);
              plotOver(bx, by, 0.48 * life, 0.58, 0.2);
            }
          }

          /* 帆船：贴着海面走。深度 v 换算成行 —— 贴着地平线的是远处（小、慢），
             贴着画面底的是近处（大、快）。随浪起伏的幅度也跟着 v 放大。 */
          for (let i = 0; i < boats.length; i += 1) {
            const bt = boats[i];
            const pad = cols * 0.06;
            const bx = wrap(bt.x + bt.dir * t * bt.speed + pad, cols + pad * 2) - pad;
            const row = lerp(horizon + 1, rows - 1.5, Math.pow(bt.v, 1.35));
            const tilt = Math.sin(t * (0.55 + bt.v) + bt.phase) * (0.45 + bt.v * 1.1);
            drawBoat(
              bx,
              row,
              Math.max(2.8, cols * 0.021 * (0.45 + bt.v)),
              bt.dir,
              life,
              tilt,
              goldW,
              bt.kind,
            );
          }
        }
      };

      const hueIdx = (h: number) => {
        const v = h - Math.floor(h);
        const i = Math.floor(v * HUE_STEPS) % HUE_STEPS;
        return i < 0 ? i + HUE_STEPS : i;
      };

      /* ============================================================
         分段显影：先给背景，再给界面
         ------------------------------------------------------------
         html 上那个 is-boot 是 <head> 里的内联脚本加的（没有 JS 就不会有）。
         这里负责在合适的时机摘掉它 —— 摘掉之后 CSS 的过渡把标题、字集、
         正文、页脚依次浮上来（延迟写在样式里）。

         ⚠️ 这两个函数必须声明在 render() **之前**：render 末尾会调 markBooted，
         而 render 是个 const 箭头函数。虽然它第一次被调用时这两个已经初始化了，
         但只要以后有人在更早的地方调一次 render，就会撞上 TDZ 报错 ——
         打包之后连变量名都被压缩器重用过，报错信息根本看不出是哪儿。
         ============================================================ */
      let booted = false;
      const revealUI = () => document.documentElement.classList.remove('is-boot');
      const markBooted = () => {
        if (booted) return;
        booted = true;
        /* 让背景先自己亮一下再上界面 —— 这一下是「等待」的那口气，
           太短（原来 260ms）界面几乎和背景一起出来，等于没有先后。 */
        window.setTimeout(revealUI, reduced ? 0 : 420);
      };
      /* 兜底：画布拿不到、脚本中途报错、第一帧迟迟不来 ——
         2.5 秒之后无论如何都把界面放出来，不能把内容永远藏住。 */
      window.setTimeout(revealUI, 2500);

      const render = (t: number) => {
        if (!ctx) return;
        drawScene(t);

        ctx.clearRect(0, 0, W, H);

        /* 天空现在是**一整片纯色渐变**（字符层已经撤掉），所以这层不是「垫在字
           底下」，它自己就是画面。范围仍然铺到 horizon —— 天与海之间那段
           「流星带」的高度也归它管，不再靠字符叠出来。
           海面另垫一层：贴着地平线最亮（那一片在反射天光），往下压深。 */
        if (dayFillAlpha > 0.004) {
          const skyPx = Math.max(1, horizon * cellH);
          const g = ctx.createLinearGradient(0, 0, 0, skyPx);
          const skyMid = Math.min(0.95, bandTop / Math.max(1, horizon));
          if (dayFillMid) {
            /* 黄金时刻的天是**五段**的：靛 → 紫玫瑰 → 暮粉 → 橙 → 亮黄。
               只给「靛 → 橙」两个色标的话，中间会从灰里穿过去，烧不起来；
               而如果橙占得太宽，天空下段就成了一条平坦的「纸板」——
               所以把橙压到 0.9，最亮的亮黄只留在地平线那一线。
               每段还带自己的透明度：下亮上暗，天顶才不会被一起冲淡
               （天顶那 42% 让 CSS 的夜空渐变透上来，正好压成深靛）。
               注意这是 RGB 插值，不是色相插值 —— 色相从 216° 走到 34° 会经过绿色。 */
            g.addColorStop(0, rgba(dayFillTop, lerp(1, 0.42, goldMix)));
            g.addColorStop(0.42, rgba(dayFillMid, lerp(1, 0.7, goldMix)));
            g.addColorStop(skyMid, rgba(dayFillDusk, lerp(1, 0.92, goldMix)));
            g.addColorStop(0.9, rgba(dayFillBot, 1));
            g.addColorStop(1, rgba(dayFillHor, 1));
          } else {
            /* 白天：天顶深蓝 → 地平线暖白，一条干净的直线。
               原来是「铺到 bandTop 就换成暖白、之后一平到底」——
               那是给字符当底用的；现在天自己就是画面，平掉的那一段会成一条硬边。 */
            g.addColorStop(0, rgba(dayFillTop, 1));
            g.addColorStop(1, rgba(dayFillBot, 1));
          }
          ctx.globalAlpha = dayFillAlpha;
          ctx.fillStyle = g;
          ctx.fillRect(0, 0, W, skyPx);

          /* 海面也垫一层：贴着地平线最亮（那一片在反射天光），往下压深 ——
             近处的水本来就比远处暗。不垫的话，亮天配黑海会很假。 */
          const seaTop = Math.max(0, Math.min(H - 1, Math.floor(horizon * cellH)));
          const g2 = ctx.createLinearGradient(0, seaTop, 0, H);
          g2.addColorStop(0, dayFillSeaTop);
          if (dayFillMid) {
            /* 黄金时刻的海面：贴着地平线是一条被日头点着的金带，往下很快沉进紫蓝。
               所以中间多一个色标 —— 暖色只留在最上面那一小段，
               再往下就是水的本色，不然整片海会糊成一块橙。 */
            g2.addColorStop(0.055, dayFillBot);
            g2.addColorStop(0.14, dayFillSeaMid);
            g2.addColorStop(1, dayFillSeaDeep);
          } else {
            g2.addColorStop(0.16, dayFillSeaDeep);
            g2.addColorStop(1, dayFillSeaDeep);
          }
          ctx.globalAlpha = dayFillAlpha * 0.72;
          ctx.fillStyle = g2;
          ctx.fillRect(0, seaTop, W, H - seaTop);
          ctx.globalAlpha = 1;

          /* 以日头为圆心的一圈径向辉光。天空改成纯色之后，这层从「锦上添花」
             变成了**必需** —— 日头周围的光晕原本是靠天光那一层的字符亮度撑起来的，
             现在只剩它了。
             配色随黄金时刻插值：白天是白热的柔光，黄昏换成更大更暖的一团。
             放在字符之前画，所以它垫在字的下面，只负责把底色推暖推亮。 */
          if (sunGlow > 0.004) {
            const cx = glowX * cellW;
            const cy = glowY * cellH;
            const r = Math.max(W, H) * lerp(0.44, 0.66, goldWNow);
            const rg = ctx.createRadialGradient(cx, cy, 0, cx, cy, r);
            rg.addColorStop(0, rgba(mixHex('#fffaf0', '#ffe8b2', goldWNow), lerp(0.72, 0.9, goldWNow)));
            rg.addColorStop(0.3, rgba(mixHex('#fff2d8', '#ffb060', goldWNow), lerp(0.34, 0.44, goldWNow)));
            rg.addColorStop(0.64, rgba(mixHex('#ffe0b4', '#ff8c4a', goldWNow), lerp(0.12, 0.16, goldWNow)));
            rg.addColorStop(1, rgba('#ff8c4a', 0));
            ctx.globalAlpha = sunGlow;
            ctx.fillStyle = rg;
            ctx.fillRect(0, 0, W, H);
            ctx.globalAlpha = 1;
          }
        }

        const ramp = RAMPS[mode];
        const lastChar = ramp.length - 1;
        const binary = mode === 'binary';

        for (let y = 0; y < rows; y += 1) {
          const py = y * cellH;
          const rowBase = y * cols;
          for (let x = 0; x < cols; x += 1) {
            const idx = rowBase + x;
            let b = intensity[idx];
            // 负数 = 强制覆盖（热气球 / 鸟剪影），取绝对值，后面的逻辑一律不用改
            if (b < 0) b = -b;

            let ch: string;
            let lit: number;
            let hh: number;
            let ss: number;

            if (binary) {
              if (b <= 0) {
                /* 空无一物的地方铺一层很暗的 0 —— 这就是「01 字符串」的那层底。
                   ⚠️ 但**天空不铺**：天空现在是纯色渐变，再盖一层均匀的 0
                   就又把那张网贴回去了，等于白改。01 模式的身份交给海面承担。 */
                if (y < horizon) continue;
                ch = '0';
                // 海面以下压得更暗：01 模式下也要能读出纵深
                lit = 0.085;
                hh = 0.6;
                ss = 0.42;
              } else {
                if (b > 1) b = 1;
                // 有序抖动：亮度高于阈值就写 1，否则写 0 —— 一片区域里 1 越密就越亮
                const one = b > BAYER[(y & 3) * 4 + (x & 3)];
                ch = one ? '1' : '0';
                lit = one ? 0.34 + 0.56 * b : 0.15 + 0.3 * b;
                hh = hueBuf[idx];
                ss = satBuf[idx];
              }
            } else {
              // ASCII 模式下暗到看不见的格子干脆留空 —— 太空本来就该是黑的
              if (b <= 0.045) continue;
              if (b > 1) b = 1;
              const ci = clamp(Math.round(Math.pow(b, 0.82) * lastChar), 0, lastChar);
              ch = ramp[ci];
              if (ch === ' ') continue;
              lit = 0.1 + 0.74 * Math.pow(b, 0.8);
              hh = hueBuf[idx];
              ss = satBuf[idx];
            }

            const si = clamp(Math.round(ss * (SAT_STEPS - 1)), 0, SAT_STEPS - 1);
            const li = clamp(Math.round(lit * (LIT_STEPS - 1)), 0, LIT_STEPS - 1);
            ctx.fillStyle = palette[(hueIdx(hh) * SAT_STEPS + si) * LIT_STEPS + li];
            ctx.fillText(ch, Math.round(x * cellW), py);
          }
        }

        /* 第一帧落地了 —— 背景已经在，可以把界面浮上来了。
           放在 render() 的末尾（而不是别处），因为只有这里能保证
           「字符画真的画出来了」这件事已经发生。 */
        markBooted();
      };

      /* ============================================================
         循环：锁 30fps，切后台就停；掉帧自动降密度。
         ============================================================ */
      const FRAME_MS = 1000 / 30;
      let raf = 0;
      let lastTime = 0;
      let acc = 0;

      const considerDegrade = () => {
        if (costAvg <= 20 || quality <= 0.5) return;
        quality = Math.max(0.5, quality - 0.18);
        costAvg = 8;
        build();
      };

      const frame = (now: number) => {
        raf = requestAnimationFrame(frame);
        if (!lastTime) lastTime = now;
        const dt = now - lastTime;
        lastTime = now;
        acc += dt;
        if (acc < FRAME_MS) return;
        acc = Math.min(acc % FRAME_MS, FRAME_MS);

        const t0 = performance.now();
        render(now / 1000);
        const cost = performance.now() - t0;
        costAvg = costAvg * 0.9 + cost * 0.1;

        frameCount += 1;
        if (frameCount % 90 === 0) considerDegrade();
      };

      const start = () => {
        if (reduced || raf) return;
        lastTime = 0;
        raf = requestAnimationFrame(frame);
      };

      const stop = () => {
        if (!raf) return;
        cancelAnimationFrame(raf);
        raf = 0;
      };

      /* ============================================================
         字集开关（现在藏在衣架图标后面）
         ============================================================ */
      const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.dock__opt'));
      const modeLabel = document.getElementById('mode-label');

      const setMode = (next: Mode) => {
        mode = next;
        for (const btn of modeButtons) {
          btn.setAttribute('aria-pressed', String(btn.dataset.mode === next));
        }
        if (modeLabel) modeLabel.textContent = next === 'binary' ? '01' : 'ASCII';
        try {
          localStorage.setItem('wired-charset', next);
        } catch {
          /* 隐私模式下存不了也无所谓 */
        }
        if (reduced) render(8);
      };

      for (const btn of modeButtons) {
        btn.addEventListener('click', () => {
          setMode(btn.dataset.mode === 'binary' ? 'binary' : 'ascii');
        });
      }

      /* ============================================================
         图标导航：衣架展开字集，爱心会躲开
         ============================================================ */
      const hanger = document.getElementById('dock-hanger');
      const charsetPanel = document.getElementById('charset');

      const setCharsetOpen = (open: boolean) => {
        if (!hanger || !charsetPanel) return;
        charsetPanel.hidden = !open;
        hanger.setAttribute('aria-expanded', String(open));
      };

      hanger?.addEventListener('click', () => {
        setCharsetOpen(charsetPanel?.hidden ?? false);
      });

      /* 点面板外面、按 Esc 都收起来 —— 展开着不收会一直挂在画面上挡着海。
         用 pointerdown 而不是 click：click 要等抬手，面板会「粘」一下。
         判据里带上 hanger 自己，否则点衣架会先被这里关掉、再被上面打开。 */
      document.addEventListener('pointerdown', (event) => {
        if (!charsetPanel || charsetPanel.hidden) return;
        const t = event.target as Node | null;
        if (t && (charsetPanel.contains(t) || hanger?.contains(t))) return;
        setCharsetOpen(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setCharsetOpen(false);
      });

      /* ---------- 爱心：点一下就躲开，背后没有任何链接 ---------- */
      const heart = document.getElementById('dock-heart');
      let heartTimer = 0;
      heart?.addEventListener('click', () => {
        /* 躲的范围压得不大：偏移再大它就飘到正文上去了，
           那就不是「让开」而是「飞走」。 */
        const dx = (Math.random() * 2 - 1) * 88;
        const dy = (Math.random() * 2 - 1) * 52 - 8;
        heart.style.transform = `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px)`;
        /* 停一会儿自己挪回来，不然它会永远卡在一边。 */
        window.clearTimeout(heartTimer);
        heartTimer = window.setTimeout(() => {
          heart.style.transform = '';
        }, 2600);
      });

      try {
        // 也可以用 ?charset=01 直接指定，方便分享时带上自己喜欢的字集（优先于本地记忆）
        const wanted = new URLSearchParams(window.location.search).get('charset');
        const saved = localStorage.getItem('wired-charset');
        if (wanted === 'binary' || wanted === '01') setMode('binary');
        else if (wanted === 'ascii') setMode('ascii');
        else if (saved === 'binary' || saved === 'ascii') setMode(saved);
      } catch {
        /* 忽略 */
      }

      /* ============================================================
         时钟与访客计数（与主站同一个接口、同一个会话标记）
         ============================================================ */
      const clock = document.getElementById('clock');
      const tickClock = () => {
        if (clock) clock.textContent = new Date().toLocaleTimeString('zh-CN', { hour12: false });
      };
      tickClock();
      setInterval(tickClock, 1000);

      const digits = document.getElementById('visit-digits');
      if (digits) {
        const key = 'visit-counted';
        const shouldCount = !sessionStorage.getItem(key);

        fetch(shouldCount ? '/api/visit?inc=1' : '/api/visit', {
          headers: { accept: 'application/json' },
        })
          .then((response) =>
            response.ok ? response.json() : Promise.reject(new Error(String(response.status))),
          )
          .then((data: { count?: number }) => {
            if (typeof data.count !== 'number') return;
            sessionStorage.setItem(key, '1');
            digits.textContent = '';
            digits.dataset.state = 'ok';
            for (const digit of String(data.count).padStart(8, '0').slice(-8)) {
              const cell = document.createElement('i');
              cell.textContent = digit;
              digits.append(cell);
            }
          })
          .catch(() => {
            // 本地静态预览（没起 Functions）时静默降级，不打扰读者
            digits.dataset.state = 'error';
          });
      }

      /* ============================================================
         潮声：一段现场合成的噪声，低通后由极慢的 LFO 推动音量。
         默认关闭 —— 出声这件事必须由读者自己决定。
         ============================================================ */
      let audioCtx: AudioContext | undefined;
      let ambience: { src: AudioBufferSourceNode; lfo: OscillatorNode; gain: GainNode } | null = null;

      const ensureCtx = (): AudioContext | undefined => {
        const Ctor =
          window.AudioContext ??
          (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!Ctor) return undefined;
        audioCtx ??= new Ctor();
        return audioCtx;
      };

      /* ------------------------------------------------------------
         进入音：从入口门按 ENTER 过来的那一次，落页时补一声。
         声音没法跨文档 —— 在门口响、页面立刻被换掉，只会剩下半声，
         所以门那边只在按下的瞬间写一个一次性标记（wired-enter-sound），
         真正的播放挪到这里。这次跳转本身就是用户手势，浏览器会放行；
         万一被自动播放策略拦下（比如直接把网址贴进地址栏后又刷新），
         也只是没这一声，绝不挡页面。
         ------------------------------------------------------------ */
      const playEnterChime = (ctx: AudioContext) => {
        const now = ctx.currentTime + 0.02;
        [523.25, 659.25, 987.77].forEach((freq, index) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          const start = now + index * 0.06;
          osc.type = 'square';
          osc.frequency.value = freq;
          gain.gain.setValueAtTime(0.0001, start);
          gain.gain.exponentialRampToValueAtTime(0.05, start + 0.01);
          gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.18);
          osc.connect(gain).connect(ctx.destination);
          osc.start(start);
          osc.stop(start + 0.2);
        });
      };

      const consumeEnterSound = () => {
        let armed = false;
        try {
          armed = sessionStorage.getItem('wired-enter-sound') === '1';
          if (armed) sessionStorage.removeItem('wired-enter-sound');
        } catch {
          /* 隐私模式：读不到就没有这一声 */
        }
        if (!armed) return;

        const ctx = ensureCtx();
        if (!ctx) return;
        if (ctx.state === 'running') {
          playEnterChime(ctx);
          return;
        }
        // resume() 被自动播放策略挡住时返回的是一个永远不落地的 promise，
        // 所以这里只挂 then，不 await、不排队，挡不住任何东西。
        void ctx.resume().then(() => {
          if (ctx.state === 'running') playEnterChime(ctx);
        });
      };

      const soundBtn = document.getElementById('toggle-sound');

      const syncSound = (on: boolean) => {
        if (soundBtn) {
          soundBtn.textContent = `潮声：${on ? '开' : '关'}`;
          soundBtn.setAttribute('aria-pressed', String(on));
        }
      };

      const startAmbience = () => {
        if (ambience) return;
        const ctx = ensureCtx();
        if (!ctx) return;
        void ctx.resume();

        const seconds = 6;
        const length = Math.floor(ctx.sampleRate * seconds);
        const buffer = ctx.createBuffer(1, length, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        let low = 0;
        let mid = 0;
        for (let i = 0; i < length; i += 1) {
          const white = Math.random() * 2 - 1;
          low = 0.995 * low + 0.005 * white; // 低频涌浪
          mid = 0.92 * mid + 0.08 * white; // 浪花的细碎
          data[i] = low * 3.2 + mid * 0.22;
        }

        const src = ctx.createBufferSource();
        src.buffer = buffer;
        src.loop = true;

        const hp = ctx.createBiquadFilter();
        hp.type = 'highpass';
        hp.frequency.value = 55;

        const lp = ctx.createBiquadFilter();
        lp.type = 'lowpass';
        lp.frequency.value = 700;
        lp.Q.value = 0.4;

        const gain = ctx.createGain();
        gain.gain.value = 0.0001;

        // 0.07 Hz 的 LFO 推着音量起伏 —— 一次「潮」大约 14 秒
        const lfo = ctx.createOscillator();
        lfo.type = 'sine';
        lfo.frequency.value = 0.07;
        const lfoDepth = ctx.createGain();
        lfoDepth.gain.value = 0.026;
        lfo.connect(lfoDepth).connect(gain.gain);

        src.connect(hp).connect(lp).connect(gain).connect(ctx.destination);
        src.start();
        lfo.start();
        gain.gain.linearRampToValueAtTime(0.05, ctx.currentTime + 2.5);

        ambience = { src, lfo, gain };
      };

      const stopAmbience = () => {
        if (!ambience || !audioCtx) return;
        const { src, lfo, gain } = ambience;
        const ctx = audioCtx;
        const now = ctx.currentTime;
        gain.gain.cancelScheduledValues(now);
        gain.gain.setValueAtTime(gain.gain.value, now);
        gain.gain.linearRampToValueAtTime(0.0001, now + 0.6);
        try {
          src.stop(now + 0.7);
          lfo.stop(now + 0.7);
        } catch {
          /* 已经停了，忽略 */
        }
        ambience = null;
      };

      soundBtn?.addEventListener('click', () => {
        const on = soundBtn.getAttribute('aria-pressed') !== 'true';
        if (on) startAmbience();
        else stopAmbience();
        syncSound(on);
      });

      /* ============================================================
         启动
         ============================================================ */
      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          build();
          if (reduced) render(8);
        }, 220);
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });

      consumeEnterSound();

      if (canvas && ctx) {
        build();
        if (reduced) render(8);
        else start();
      } else {
        /* 画布拿不到就别等了 —— 界面立刻放出来，
           不然 is-boot 会把内容一直藏着（虽然 2.5 秒后也有兜底，但没必要等）。 */
        revealUI();
      }
    </script>
  </body>
</html>
