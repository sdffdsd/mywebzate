---
/**
 * /wired/ —— 星海（WIRED NODE）
 *
 * 这一版的目标只有一个：把背景做成一张「上半为宇宙、下半为大海」的实时字符画，
 * 并且有真正的纵深感 —— 近处大而暗、远处小而糊，中间一条发光的地平线。
 *
 * 画法（全部在浏览器里现算，没有任何图片 / 字体 / 音频文件）：
 *   1. 把视口切成等宽字符网格（列宽 = 实测字宽，所以网格严格对齐）。
 *   2. 画面分三段：天空（星云 / 星 / 一轮月或日 / 热气球 / 鸟群）→ 流星带 → 海面。
 *      中间那段流星带就是天与海之间新长出来的过渡：一个个字符从带顶落向
 *      地平线，进场时慢慢亮起来，中段最亮，再一路暗下去熄灭。
 *   3. 整片天空连同星和月一起向左缓慢漂移，越「近」的天体走得越快，
 *      月亮在水面上的那条光路跟着它一起挪。
 *   3b. 漂移的**起点**由访问者的本地时间决定，整幅画跟着「现在几点」走：
 *      夜里（18:00–06:00）月亮东升西落、星空一起转；
 *      白天（06:00–18:00）太阳走同一条轨道，天光亮起来、星星星云流星一起退场。
 *      两者在 06:00 / 18:00 都贴着地平线，所以是同一套坐标算出来的，接得上。
 *      ?t=HH:MM 可以覆盖本地时间，方便对时。
 *   4. 每帧给每个格子算一个「亮度 + 色相 + 饱和度」，分九层叠加：
 *        白天的天光 → 星云 → 流星带的雾 → 流星 → 星 → 月/日 → 地平线光带
 *        → 海面（透视压缩的浪 + 日月碎成的一条路）→ 热气球与鸟群
 *      最后一层走的是**强制覆盖**通道（亮度存成负数）：鸟是逆光的剪影，
 *      比亮天更暗，用「取最大值」的常规通道会被天整个吃掉。
 *   5. 亮度决定字形（ASCII 密度阶梯，或 0/1 的有序抖动）与颜色深浅。
 *
 * 上一版这里的「噪音」全部删掉了：
 *   没有 glitch、没有扫描线、没有 CRT 闪烁、没有跑马灯、没有随机跳动的信号灯、
 *   没有拖拽弹窗、没有恼人的悬停音效。剩下的只有缓慢的星与潮。
 *
 * 唯一的例外是标题：WIRED NODE 现在是像素字，字形里带着横向扫描线的断点。
 * 那层扫描线**只作用在标题的字形内部、且完全静止**（不是盖在整屏上的 CRT 滤镜，
 * 也不闪烁），是字体本身的表现形式，不是叠加的噪点 —— 所以它不违背上面那条原则。
 *
 * 页面上也不放说明性文字：屏幕上的字只有站名、标题、字集开关、现场数据与导航，
 * 不再有解说画面的话 —— 画面自己说话。
 *
 * 工程底线（与主站一致）：
 *   - 零外部资源；无 JS 时不留白屏（背景退化成 CSS 渐变，正文照常可读）。
 *   - prefers-reduced-motion 下只画一帧静态画面，不做任何循环动画。
 *   - 帧率自适应：掉帧就自动降低字符密度，而不是让风扇起飞。
 *   - 切到后台立刻停掉 requestAnimationFrame。
 */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const year = new Date().getFullYear();
const title = 'WIRED NODE · 星海';
const description =
  'za4ever.com 的手工分站：上半为宇宙、下半为大海的实时字符画，可在 ASCII 与 01 两种字集之间切换。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#04060d" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}

    <style is:inline>
      /* ============================================================
         设计令牌：一套「深夜海面」的配色。
         主站是顺滑克制的系统字体；这里是等宽字符 + 硬边框。
         ============================================================ */
      :root {
        --bg: #04060d;
        --ink: #d6e9f7;
        --dim: #9db4c8;
        --faint: #7c93a8;
        --cyan: #7fe6ff;
        --violet: #b79bff;
        --line: rgba(150, 205, 255, 0.2);
        --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "PingFang SC",
          "Microsoft YaHei", monospace;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        min-height: 100svh;
        color: var(--ink);
        background-color: var(--bg);
        /* 无 JS 时的兜底画面：同一套配色的垂直渐变，地平线钉在视口正中。
           Canvas 是透明的，只往上叠字符，所以这层渐变同时也是整页的底色。 */
        background-image: linear-gradient(
          to bottom,
          #03050c 0%,
          #070818 18%,
          #120c26 32%,
          #1e1138 45%,
          rgba(122, 152, 214, 0.14) 57%,
          rgba(110, 210, 240, 0.3) 62.4%,
          rgba(110, 210, 240, 0.3) 63.6%,
          #0a2036 64.8%,
          #08192b 78%,
          #050f1d 90%,
          #02050b 100%
        );
        background-attachment: fixed;
        font-family: var(--mono);
        font-size: 15px;
        line-height: 1.75;
        letter-spacing: 0.02em;
        overflow-x: hidden;
      }

      /* 字符画本体：铺满视口、固定在背景层，永远不接鼠标事件 */
      #field {
        position: fixed;
        inset: 0;
        z-index: 0;
        display: block;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }

      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 90;
        padding: 0.6rem 1rem;
        background: var(--cyan);
        color: #04121a;
      }

      .skip-link:focus {
        left: 0.75rem;
        top: 0.75rem;
      }

      a {
        color: var(--dim);
        text-decoration: none;
      }

      a:hover {
        color: var(--cyan);
      }

      :focus-visible {
        outline: 2px solid var(--cyan);
        outline-offset: 3px;
      }

      .page {
        position: relative;
        z-index: 1;
      }

      /* ============================================================
         首屏：把标题放在地平线以上的天空里
         ============================================================ */
      .hero {
        min-height: 100svh;
        display: grid;
        align-content: center;
        justify-items: center;
        text-align: center;
        /* 下边留出大片海面：正文整体落在天与海的分界之上 */
        padding: 2.5rem 1.25rem 42vh;
      }

      .hero__inner {
        display: grid;
        gap: 1rem;
        justify-items: center;
        /* 撑满到 max-width：不写这一条的话，.hero 的 justify-items:center 会把它
           收缩到内容宽（约 402px），标题画布只拿得到 298px —— 像素字在那点宽度上
           一个格才 4px 出头，点阵和扫描线都糊在一起，等于白做。 */
        width: 100%;
        max-width: 46rem;
        padding: 3rem clamp(1.75rem, 6vw, 3.25rem);
        /* 一团柔和的暗色晕圈：压住背后的字符，保证文字始终读得清。
           它不是边框也不是卡片，所以看起来仍然像「字浮在星海上」。
           字符网格加密之后星星多了，所以这里把过渡拉得更长、更平 ——
           否则在密星里会看出一个椭圆形的「洞」。
           白天 JS 会把 --halo 调低（0.93 → 0.62）：天亮了罩子还这么黑就成了黑斑，
           但也不能再低 —— 标题最暗的那支是 #4f9fc8，底下亮过 90 就压不住了。 */
        background: radial-gradient(
          ellipse at center,
          rgba(3, 6, 14, var(--halo, 0.93)) 0%,
          rgba(3, 6, 14, calc(var(--halo, 0.93) * 0.8)) 34%,
          rgba(3, 6, 14, calc(var(--halo, 0.93) * 0.43)) 58%,
          rgba(3, 6, 14, calc(var(--halo, 0.93) * 0.15)) 78%,
          rgba(3, 6, 14, 0) 100%
        );
      }

      /* 标题：像素字。
         视觉全部由画布承担，所以这里只管排版宽度 —— 字号由画布按宽度反推，
         保证 69 列点阵永远铺满这一行的可用宽度。 */
      .hero__title {
        margin: 0;
        width: 100%;
        max-width: 34rem;
      }

      /* 这段文字只留给读屏与搜索引擎，视觉上是画布在说话 */
      .hero__title-text {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }

      .hero__title-glyphs {
        display: block;
        width: 100%;
        height: auto;
        /* 保留原来那层冷光：画布本身画不出 text-shadow，用 drop-shadow 顶上。
           白天标题换成深蓝，这层青光要跟着退掉（--title-glow 由 JS 写）。 */
        filter: drop-shadow(0 0 16px rgba(120, 220, 255, var(--title-glow, 0.38)))
          drop-shadow(0 2px 18px rgba(0, 0, 0, 0.85));
      }

      /* 字集开关：对应参考站里的 charset 选择 */
      .seg {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-top: 0.6rem;
        padding: 0.3rem 0.4rem 0.3rem 0.85rem;
        border: 1px solid var(--line);
        background: rgba(5, 9, 18, 0.66);
        backdrop-filter: blur(7px);
      }

      .seg__label {
        font-size: 0.7rem;
        letter-spacing: 0.24em;
        color: var(--faint);
      }

      .seg__btn {
        font: inherit;
        font-size: 0.8rem;
        letter-spacing: 0.14em;
        padding: 0.3rem 0.9rem;
        color: var(--dim);
        background: transparent;
        border: 1px solid transparent;
        cursor: pointer;
      }

      .seg__btn:hover {
        color: var(--cyan);
      }

      .seg__btn[aria-pressed='true'] {
        color: #04121a;
        background: var(--cyan);
        border-color: var(--cyan);
      }

      /* ============================================================
         正文面板：半透明深色底 + 毛玻璃，保证字符画上也能读
         ============================================================ */
      main {
        max-width: 56rem;
        margin: 0 auto;
        padding: 0 1.25rem 1.15rem;
        display: grid;
        gap: 1.15rem;
      }

      .panel {
        padding: 1.4rem 1.5rem;
        border: 1px solid var(--line);
        /* 0.86 的不透明度：背后的字符画仍然透得出来，但正文不会被浪尖的高光咬碎。
           毛玻璃只是锦上添花 —— 有些环境（关掉 GPU 合成）不会生效，所以底色必须自己够实。 */
        background: rgba(4, 8, 17, 0.86);
        backdrop-filter: blur(14px) saturate(120%);
        box-shadow: 0 20px 54px rgba(0, 0, 0, 0.4);
      }

      .panel h2 {
        margin: 0 0 0.9rem;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--cyan);
      }

      /* 现场数据 */
      .facts {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 1.1rem;
        margin: 0;
      }

      .facts div {
        padding-left: 0.9rem;
        border-left: 1px solid var(--line);
      }

      .facts dt {
        font-size: 0.7rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--faint);
      }

      .facts dd {
        margin: 0.35rem 0 0;
        font-size: 1.05rem;
        color: var(--ink);
      }

      .digits {
        display: inline-flex;
        gap: 2px;
      }

      .digits i {
        font-style: normal;
        padding: 0.1rem 0.35rem;
        font-size: 0.95rem;
        background: rgba(120, 220, 255, 0.1);
        border: 1px solid rgba(120, 220, 255, 0.26);
        color: #e2f5ff;
      }

      .digits[data-state='error'] i {
        color: var(--faint);
      }

      /* 链接列表 */
      .links {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .links a {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.6rem 0.15rem;
        border-bottom: 1px dashed rgba(150, 205, 255, 0.16);
      }

      .links li:last-child a {
        border-bottom: 0;
      }

      .links small {
        font-size: 0.74rem;
        color: var(--faint);
      }

      /* ============================================================
         页脚：音效开关与回程
         ============================================================ */
      .foot {
        position: relative;
        z-index: 1;
        max-width: 56rem;
        /* 与面板同一张底：页脚下的浪尖最密，没有这层底，版权行会被 1 与 @ 咬碎 */
        margin: 0 auto 3rem;
        padding: 1.1rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem 1.5rem;
        align-items: center;
        justify-content: space-between;
        border: 1px solid var(--line);
        background: rgba(4, 8, 17, 0.86);
        backdrop-filter: blur(14px) saturate(120%);
        box-shadow: 0 20px 54px rgba(0, 0, 0, 0.4);
        color: var(--faint);
        font-size: 0.78rem;
      }

      .foot__ctl {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
      }

      .foot button {
        font: inherit;
        font-size: 0.78rem;
        padding: 0.4rem 0.9rem;
        color: var(--dim);
        background: rgba(5, 9, 18, 0.66);
        border: 1px solid var(--line);
        cursor: pointer;
      }

      .foot button:hover {
        color: var(--cyan);
        border-color: var(--cyan);
      }

      @media (max-width: 640px) {
        body {
          font-size: 14px;
        }

        .hero {
          padding: 2rem 1.25rem 40vh;
        }

        .hero__inner {
          padding: 1.75rem 0.75rem;
        }

        /* 像素字的字号由画布按宽度反推，这里只需要放开宽度上限 */
        .hero__title {
          max-width: 100%;
        }

        .panel {
          padding: 1.15rem 1.1rem;
        }
      }
    </style>
  </head>

  <body>
    <canvas id="field" aria-hidden="true"></canvas>

    <a class="skip-link" href="#main">跳到主要内容</a>

    <div class="page">
      <header class="hero">
        <div class="hero__inner">
          <h1 class="hero__title">
            <span class="hero__title-text">WIRED NODE</span>
            <canvas class="hero__title-glyphs" id="title-glyphs" aria-hidden="true"></canvas>
          </h1>

          <div class="seg" role="group" aria-label="字符集">
            <span class="seg__label">字集</span>
            <button class="seg__btn" type="button" data-mode="ascii" aria-pressed="true">ASCII</button>
            <button class="seg__btn" type="button" data-mode="binary" aria-pressed="false">01</button>
          </div>
        </div>
      </header>

      <main id="main">
        <section class="panel">
          <h2>现场</h2>
          <dl class="facts">
            <div>
              <dt>本地时间</dt>
              <dd id="clock">--:--:--</dd>
            </div>
            <div>
              <dt>当前字集</dt>
              <dd id="mode-label">ASCII</dd>
            </div>
            <div>
              <dt>访客</dt>
              <dd>
                <span class="digits" id="visit-digits" data-state="loading">
                  <i>—</i><i>—</i><i>—</i><i>—</i><i>—</i><i>—</i><i>—</i><i>—</i>
                </span>
              </dd>
            </div>
          </dl>
        </section>

        <section class="panel">
          <h2>去哪</h2>
          <ul class="links">
            <li><a href="/"><span>回主站</span><small>za4ever.com</small></a></li>
            <li><a href="/notes/"><span>笔记</span><small>/notes/</small></a></li>
            <li>
              <a href="https://github.com/sdffdsd/mywebzate" rel="noopener">
                <span>源码仓库</span><small>github</small>
              </a>
            </li>
          </ul>
        </section>
      </main>

      <footer class="foot">
        <span>© {year} ZAKURA</span>
        <span class="foot__ctl">
          <button id="toggle-sound" type="button" aria-pressed="false">潮声：关</button>
          <a href="/">← 回主站</a>
        </span>
      </footer>
    </div>

    <script>
      /* 白天进度（0 = 夜，1 = 正午）。
         标题是另一块画布、单独绘制的，靠下面这个回调把进度喂进去 ——
         天亮之后标题必须从浅青换成深蓝，否则浅字压在亮天上直接糊掉。 */
      let titleDayness = 0;
      let titleRedraw: ((d: number) => void) | null = null;

      /* ============================================================
         标题：像素字（和背景星海无关，先单独跑完）
         ------------------------------------------------------------
         字形取自「缝合像素字体 Fusion Pixel 12px」的 9 行点阵，逐格采样后
         只留下标题用得到的 7 个字母（W I R E D N O）硬编码在这里 ——
         比整份字体小三个数量级，也守住了本站「零外部字体 / 零资源文件」的底线。

         画法分两步，顺序不能反：
           1. 先把点阵铺成**实心**的字（相邻格子不留缝）；
           2. 再用横向扫描线把整字高切成 5 段，每段实心 90.5%。
         于是竖笔断成一串方点，而横笔比一段还矮、整段落在实心里，保持实心 ——
         这正是参考图里那种「数字表盘」的观感（实测参考图：方点 43px / 间隙 4.5px）。

         同一行里相邻的格子要**合并成一个矩形**再画：逐个画圆角矩形的话，
         横笔上会被圆角切出一排细缝，实心条就没了。
         ============================================================ */
      {
        const GLYPHS: Record<string, string[]> = {
          W: ['111', '111', '111', '0aa', '0aa', '0aa', '044', '044', '044'],
          I: ['7', '2', '2', '2', '2', '2', '2', '2', '7'],
          R: ['3e', '21', '21', '21', '3e', '28', '24', '22', '21'],
          E: ['3f', '20', '20', '20', '3e', '20', '20', '20', '3f'],
          D: ['3c', '22', '21', '21', '21', '21', '21', '22', '3c'],
          N: ['21', '31', '29', '29', '25', '25', '23', '23', '21'],
          O: ['1c', '22', '41', '41', '41', '41', '41', '22', '1c'],
        };
        const GLYPH_W: Record<string, number> = { W: 9, I: 3, R: 6, E: 6, D: 6, N: 6, O: 7 };
        const ROWS = 9;
        const TITLE = 'WIRED NODE';
        const LETTER_GAP = 1; // 字间距（格）
        const WORD_GAP = 7; // 空格宽（格）
        const BANDS = 5; // 整字高切成几段扫描线
        const INK = 0.905; // 每段里实心的比例（参考图实测 43 / 47.5）

        /* 把标题展开成「每列一个 9 位掩码」，列是画布的唯一坐标 */
        const columns: number[] = [];
        for (const ch of TITLE) {
          if (ch === ' ') {
            for (let i = 0; i < WORD_GAP; i += 1) columns.push(0);
            continue;
          }
          const glyph = GLYPHS[ch];
          const gw = GLYPH_W[ch];
          for (let c = 0; c < gw; c += 1) {
            let mask = 0;
            for (let r = 0; r < ROWS; r += 1) {
              const bits = parseInt(glyph[r], 16).toString(2).padStart(gw, '0');
              if (bits[c] === '1') mask |= 1 << r;
            }
            columns.push(mask);
          }
          for (let i = 0; i < LETTER_GAP; i += 1) columns.push(0);
        }
        while (columns.length && columns[columns.length - 1] === 0) columns.pop();
        const COLS = columns.length;

        const canvas = document.getElementById('title-glyphs') as HTMLCanvasElement | null;
        const host = canvas?.parentElement ?? null;

        const roundRect = (
          ctx: CanvasRenderingContext2D,
          x: number,
          y: number,
          w: number,
          h: number,
          r: number,
        ) => {
          const rr = Math.min(r, w / 2, h / 2);
          ctx.beginPath();
          ctx.moveTo(x + rr, y);
          ctx.lineTo(x + w - rr, y);
          ctx.quadraticCurveTo(x + w, y, x + w, y + rr);
          ctx.lineTo(x + w, y + h - rr);
          ctx.quadraticCurveTo(x + w, y + h, x + w - rr, y + h);
          ctx.lineTo(x + rr, y + h);
          ctx.quadraticCurveTo(x, y + h, x, y + h - rr);
          ctx.lineTo(x, y + rr);
          ctx.quadraticCurveTo(x, y, x + rr, y);
          ctx.closePath();
          ctx.fill();
        };

        let drawnW = 0;
        let drawnDpr = 0;
        let drawnTone = -1;

        /** 两个 #rrggbb 按 t 混合 */
        const mixHex = (a: string, b: string, t: number) => {
          const pa = parseInt(a.slice(1), 16);
          const pb = parseInt(b.slice(1), 16);
          const ch = (sh: number) =>
            Math.round(((pa >> sh) & 255) * (1 - t) + ((pb >> sh) & 255) * t);
          return `rgb(${ch(16)}, ${ch(8)}, ${ch(0)})`;
        };

        const drawTitle = (tone = 0) => {
          if (!canvas || !host) return;
          const cssW = Math.round(host.clientWidth);
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          if (cssW < 60 || (cssW === drawnW && dpr === drawnDpr && tone === drawnTone)) return;
          drawnW = cssW;
          drawnDpr = dpr;
          drawnTone = tone;

          const cell = cssW / COLS;
          const cssH = cell * ROWS;

          canvas.width = Math.round(cssW * dpr);
          canvas.height = Math.round(cssH * dpr);
          canvas.style.height = `${cssH}px`;

          const ctx = canvas.getContext('2d');
          if (!ctx) return;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, cssW, cssH);

          /* 左上最亮、右下收暗。夜里是浅青（深底上发亮），白天换成很深的藏蓝 ——
             亮天上再放浅青会糊成一片；而白天这套必须**压得够深**，
             因为底色抬亮之后，稍浅一点的蓝就落到和天差不多的亮度上去了。 */
          const grad = ctx.createLinearGradient(0, 0, cssW, cssH);
          grad.addColorStop(0, mixHex('#eaf9ff', '#061a2c', tone));
          grad.addColorStop(0.5, mixHex('#9adcff', '#0b2f4a', tone));
          grad.addColorStop(1, mixHex('#4f9fc8', '#104566', tone));
          ctx.fillStyle = grad;

          const radius = Math.max(0.5, cell * 0.12);
          const period = cssH / BANDS;
          const ink = period * INK;

          for (let b = 0; b < BANDS; b += 1) {
            const by0 = b * period;
            const by1 = Math.min(by0 + ink, cssH);
            for (let r = 0; r < ROWS; r += 1) {
              const py0 = Math.max(by0, r * cell);
              const py1 = Math.min(by1, (r + 1) * cell);
              if (py1 - py0 <= 0.25) continue;
              let c = 0;
              while (c < COLS) {
                if (!(columns[c] & (1 << r))) {
                  c += 1;
                  continue;
                }
                // 横向合并连续的格子，横笔才是整条而不是一排点
                let c2 = c;
                while (c2 + 1 < COLS && columns[c2 + 1] & (1 << r)) c2 += 1;
                roundRect(ctx, c * cell, py0, (c2 - c + 1) * cell, py1 - py0, radius);
                c = c2 + 1;
              }
            }
          }
        };

        if (canvas && host) {
          let curTone = 0;
          const redraw = () => drawTitle(curTone);
          redraw();
          if ('ResizeObserver' in window) {
            new ResizeObserver(redraw).observe(host);
          } else {
            window.addEventListener('resize', redraw, { passive: true });
          }
          /* 把重画入口交给主脚本：白天进度跨过一档才真的重画（drawTitle 自己会挡掉） */
          titleRedraw = (d: number) => {
            curTone = Math.pow(Math.min(1, Math.max(0, d)), 0.75);
            redraw();
          };
        }
      }

      type Mode = 'ascii' | 'binary';

      const TAU = Math.PI * 2;

      /* 天空向左漂移的速度：每秒推进视口宽度的比例。
         0.0075 = 一分钟走掉小半个屏 —— 慢到不会让人分心，又足够在一首歌里看出变化。 */
      const SKY_DRIFT = 0.0075;

      /* ============================================================
         天空的钟：月亮与星星的位置由**访问者的本地时间**决定
         ------------------------------------------------------------
         日落 18:00 → 月亮从东边（画面右侧）升起；
         午夜 00:00 → 到天顶；
         日出 06:00 → 落到西边（画面左侧）落下。
         12 小时的夜归一化成 u ∈ [0, 1)：0 刚升起、0.5 最高、1 刚落。

         白天（u ≥ 1）月亮在地平线以下，整轮不画 —— 白天的画面（太阳、
         天色、云的亮度）是另一件事，这一步不做，天空仍旧是夜空的样子。

         ?t=HH:MM 可以覆盖本地时间，方便对时（不写就用系统时间）。
         ============================================================ */
      const SUNSET_H = 18;
      const NIGHT_H = 12;

      const timeOverride = (() => {
        const m = /[?&]t=(\d{1,2})(?::(\d{2}))?/.exec(location.search);
        if (!m) return null;
        return { h: Number(m[1]) % 24, m: Number(m[2] ?? 0) % 60 };
      })();

      const clockNow = () => {
        const d = new Date();
        if (timeOverride) d.setHours(timeOverride.h, timeOverride.m, 0, 0);
        return d;
      };

      /** 当前时刻在夜里的归一化位置；白天落在 [1, 2) */
      const nightPhase = () => {
        const d = clockNow();
        const hours = d.getHours() + d.getMinutes() / 60 + d.getSeconds() / 3600;
        return (((hours - SUNSET_H + 24) % 24) / NIGHT_H);
      };

      /* 月亮的夜行轨迹：东升西落，中间划一道弧。
         横坐标从左到右是线性的，纵坐标走一条 sin^1.3 的弧 ——
         幂次比 1 大一点，月亮在贴近两端时才压得住，不会刚出来就窜到半空。 */
      const MOON_RISE_X = 1.03; // 升起时刚出画面右侧一点
      const MOON_SET_X = -0.03; // 落下时刚好出了左侧
      const MOON_ARC_POW = 1.3;

      /* 星空整夜转过的宽度（屏）：和月亮同向，天球才是一起转的 */
      const SKY_NIGHT_SPAN = 1.05;

      /* ============================================================
         白天的天光
         ------------------------------------------------------------
         06:00 日出 → 12:00 天顶 → 18:00 日落。天顶深、地平线亮 ——
         大气越靠近地平线越厚，真实的白昼也是那一带最白。
         dayness 用 sin^0.55 而不是 sin：一次方在 07:00 才爬到 0.26，
         天迟迟不亮；压到 0.55 之后 07:00 已经有 0.5，天亮得快、黄昏暗得也快。
         ============================================================ */
      const DAY_CURVE = 0.55;

      /* ------------------------------------------------------------
         白天的配色（定档：更亮更暖）
         ------------------------------------------------------------
         天顶偏深的蓝、地平线转暖白，海面抬亮并往青里偏。
         两点是调出来的、不是拍的：
           · 地平线的暖白要**先把饱和度褪掉再染暖**（见 warmBlend）——
             蓝色相直接插到暖色相会从绿色穿过去。
           · 字符底下必须垫一层真正的底色：一个等宽字符只覆盖格子三成左右，
             全画到最亮感知也只有 80/255，那是阴天不是白天。
         ------------------------------------------------------------ */
      const DAY_TONE = {
        zen: 0.6, // 天顶的字符亮度
        hor: 1.2, // 地平线的字符亮度
        hueTop: 0.572, // 天顶色相（偏深的蓝）
        hueBot: 0.51, // 地平线色相（青蓝，再靠 warmBlend 转暖白）
        satTop: 0.66,
        satBot: 0.4,
        warm: 0.92, // 地平线往暖里偏多少
        sea: 2.5, // 海面整体抬亮的倍数
        seaWarm: 0.6, // 海面往暖里偏多少
        fill: 0.85, // 底色渐变的透明度（0 = 不垫）
        fillTop: '#1a63ad', // 底色：天顶
        fillBot: '#cfd2c8', // 底色：地平线（暖白）
        seaDeep: '#1a4d6b', // 海面底色的最深处
        titleDark: 1, // 标题跟着转深藏蓝
      };
      /* 大气（雾带、地平线光带）的亮度跟着白天配色一起抬。
         1.06 = 原先那一档的天顶 + 地平线总量，用来把倍率归一到 1。 */
      const DAY_GAIN = (DAY_TONE.zen + DAY_TONE.hor) / 1.06;

      /** 蓝 → 暖白，返回 [色相, 饱和度]。
          直接插色相会从绿色穿过去（198° → 34° 中间是 115° 的黄绿），
          所以分两段走：先把蓝褪成灰（色相不动、饱和度归零），再给灰染上暖。
          交接点上饱和度正好是 0，色相怎么跳都看不出来。 */
      const warmBlend = (hueBase: number, satBase: number, w: number): [number, number] =>
        w <= 0.5
          ? [hueBase, satBase * (1 - w * 2)]
          : [lerp(hueBase, 0.095, (w - 0.5) * 2), 0.22 * (w - 0.5) * 2];

      /* 画面三段的分界（占视口高度的比例）：天空 → 流星带 → 海面。
         中间这段就是新长出来的「背景长度」：天和海不再硬碰硬地接在一起，
         而是隔着一整条过渡带，纵深也就多了一层。 */
      const SKY_EDGE = 0.45;
      const SEA_EDGE = 0.63;

      const FONT =
        'ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "PingFang SC", "Microsoft YaHei", monospace';

      /* 字符集：从暗到亮。
         ASCII 是经典密度阶梯；01 只有两级，中间调交给有序抖动去表达。 */
      const RAMPS: Record<Mode, string> = {
        ascii: ' .,:;-~=+*#%@',
        binary: ' 01',
      };

      /* 4×4 有序抖动矩阵（已归一化到 0..1）：
         01 模式下，亮度高于阈值画 1，否则画 0 —— 一片区域的 1 越密就越亮。 */
      const BAYER = new Float32Array([
        0.03, 0.53, 0.16, 0.66,
        0.78, 0.28, 0.91, 0.41,
        0.19, 0.69, 0.09, 0.59,
        0.94, 0.44, 0.84, 0.34,
      ]);

      /* 颜色查表：把 (色相 × 饱和度 × 明度) 预先算成字符串，
         每帧只做整数索引，避免在循环里拼字符串产生大量垃圾。 */
      const HUE_STEPS = 32;
      const SAT_STEPS = 4;
      const LIT_STEPS = 22;
      const palette: string[] = new Array(HUE_STEPS * SAT_STEPS * LIT_STEPS);
      for (let h = 0; h < HUE_STEPS; h += 1) {
        const hue = Math.round((h * 360) / HUE_STEPS);
        for (let s = 0; s < SAT_STEPS; s += 1) {
          const sat = Math.round((s / (SAT_STEPS - 1)) * 100);
          for (let l = 0; l < LIT_STEPS; l += 1) {
            const lit = Math.round(5 + (l / (LIT_STEPS - 1)) * 75);
            palette[(h * SAT_STEPS + s) * LIT_STEPS + l] = `hsl(${hue}, ${sat}%, ${lit}%)`;
          }
        }
      }

      const clamp = (v: number, lo: number, hi: number) => (v < lo ? lo : v > hi ? hi : v);
      /** 取模，结果永远落在 [0, m)：天空里的东西绕到另一端时用它 */
      const wrap = (v: number, m: number) => {
        const r = v % m;
        return r < 0 ? r + m : r;
      };
      const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
      const smoothstep = (a: number, b: number, x: number) => {
        if (a === b) return x < a ? 0 : 1;
        const t = clamp((x - a) / (b - a), 0, 1);
        return t * t * (3 - 2 * t);
      };

      /* 确定性哈希：同一个格子每帧得到同一个值。
         画面里所有的「随机」都在初始化时定好，绝不用逐帧随机数 —— 那是闪烁，是噪音。 */
      const hash2 = (x: number, y: number) => {
        let h = Math.imul(x | 0, 374761393) ^ Math.imul(y | 0, 668265263);
        h = Math.imul(h ^ (h >>> 13), 1274126177);
        return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
      };

      const valueNoise = (x: number, y: number) => {
        const xi = Math.floor(x);
        const yi = Math.floor(y);
        const xf = x - xi;
        const yf = y - yi;
        const u = xf * xf * (3 - 2 * xf);
        const v = yf * yf * (3 - 2 * yf);
        const a = hash2(xi, yi);
        const b = hash2(xi + 1, yi);
        const c = hash2(xi, yi + 1);
        const d = hash2(xi + 1, yi + 1);
        return lerp(lerp(a, b, u), lerp(c, d, u), v);
      };

      /** 三层叠加的分形噪声：星云的形状 */
      const fbm = (x: number, y: number) =>
        valueNoise(x, y) * 0.62 +
        valueNoise(x * 2.03 + 11.3, y * 2.07 + 7.1) * 0.28 +
        valueNoise(x * 4.1 + 3.7, y * 4.2 + 1.9) * 0.1;

      interface Star {
        x: number;
        y: number;
        z: number;
        hue: number;
        sat: number;
        phase: number;
        tw: number;
      }

      /** 一颗流星：一条定死的轨道，之后只按时间循环，没有任何逐帧随机 */
      interface Meteor {
        x: number;
        par: number;
        speed: number;
        phase: number;
        len: number;
        slant: number;
        gain: number;
        hue: number;
        sat: number;
      }

      /** 一只热气球：球体 + 收颈 + 吊篮，整体极慢地横移，偶尔上下浮一点 */
      interface Balloon {
        x: number;
        y: number;
        r: number;
        speed: number;
        hue: number;
        hue2: number;
        bob: number;
      }

      /** 鸟群里的一只鸟：相对群心的偏移 + 扇翅相位 */
      interface Bird {
        dx: number;
        dy: number;
        phase: number;
        flap: number;
      }

      /** 一群鸟：整体横移，队形是松散的 V（一只领头，两侧依次排开） */
      interface Flock {
        x: number;
        y: number;
        speed: number;
        bob: number;
        birds: Bird[];
      }

      const canvas = document.getElementById('field') as HTMLCanvasElement | null;
      const ctx = canvas?.getContext('2d', { alpha: true }) ?? null;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      let W = 0;
      let H = 0;
      let cols = 0;
      let rows = 0;
      let cellW = 8;
      let cellH = 16;
      let bandTop = 0;
      let horizon = 0;
      let aspect = 1.7;
      let intensity = new Float32Array(0);
      let hueBuf = new Float32Array(0);
      let satBuf = new Float32Array(0);
      let stars: Star[] = [];
      let meteors: Meteor[] = [];
      let balloons: Balloon[] = [];
      let flocks: Flock[] = [];
      let moonR = 4;
      let mode: Mode = 'ascii';

      /* 首屏之后自适应降级用：掉帧就减少列数（字符变大、数量变少） */
      let quality = 1;
      let costAvg = 8;
      let frameCount = 0;
      /* 标题晕罩的当前不透明度，用来避免每帧重复写 CSS 变量 */
      let lastHalo = -1;
      /* 白天的底色渐变：drawScene 写、render 读。
         字符画的亮度天花板只有 80/255 上下，白天要真的亮，只能在字符底下垫一层。 */
      let dayFillAlpha = 0;
      let dayFillTop = '#000000';
      let dayFillBot = '#000000';
      let dayFillSeaTop = '#000000';
      let dayFillSeaDeep = '#000000';

      const plot = (x: number, y: number, b: number, h: number, s: number) => {
        if (!(x >= 0 && y >= 0 && x < cols && y < rows)) return;
        const idx = y * cols + x;
        if (b <= intensity[idx]) return;
        intensity[idx] = b;
        hueBuf[idx] = h;
        satBuf[idx] = s;
      };

      /**
       * 强制覆盖地画一格：亮度存成**负数**，render 里认这个符号。
       * 为什么需要它：plot 是「取最大值」，所以只有比背景更亮的东西才画得上去。
       * 而逆光的鸟剪影是**比亮天更暗**的 —— 用 plot 会被天整个吃掉。
       * 热气球也用它：不然球面上稍暗的那几格会被天光噪声咬出洞。
       */
      const plotOver = (x: number, y: number, b: number, h: number, s: number) => {
        if (!(x >= 0 && y >= 0 && x < cols && y < rows)) return;
        const idx = y * cols + x;
        intensity[idx] = -b;
        hueBuf[idx] = h;
        satBuf[idx] = s;
      };

      /**
       * 一个热气球：上宽下窄的球体 + 收颈 + 吊索 + 吊篮，全部按格现算。
       * 球体的纵向半径要**除以 aspect** —— 字符格是 7.2×12 的长方形，
       * 不补这一下，画出来会是一根竖着的长条，不是圆球。
       */
      const drawBalloon = (
        cx: number,
        cy: number,
        r: number,
        hue: number,
        hue2: number,
        alpha: number,
      ) => {
        const bodyH = r / Math.max(1, aspect);
        const x0 = Math.floor(cx - r - 1);
        const x1 = Math.ceil(cx + r + 1);
        const y0 = Math.floor(cy - bodyH - 1);
        const y1 = Math.ceil(cy + bodyH * 2.2 + 1);
        for (let y = y0; y <= y1; y += 1) {
          const v = (y - cy) / bodyH;
          for (let x = x0; x <= x1; x += 1) {
            const u = (x - cx) / r;
            // 球体：越往下越收（v^1.6），到颈部收成一个口
            const shrink = 1 - 0.44 * Math.pow(Math.max(0, v), 1.6);
            if (v >= -1 && v <= 1 && Math.abs(u) <= shrink) {
              const d = Math.hypot(u / Math.max(0.2, shrink), v);
              // 竖条纹 = 气球的分瓣；边缘收一圈暗，圆盘才有体积感
              const rim = smoothstep(1, 0.7, d);
              const lit = 0.5 + 0.42 * (1 - Math.abs(u) * 0.55) * (1 - Math.max(0, v) * 0.3);
              const stripe = Math.sin(u * 4.4 + 0.7) > 0 ? hue2 : hue;
              plotOver(x, y, clamp(lit * rim * alpha, 0, 1), stripe, 0.6);
              continue;
            }
            // 收颈 → 吊索 → 吊篮
            const neck = Math.abs(u) < 0.15 && v > 1 && v < 1.28;
            const rope = Math.abs(Math.abs(u) - 0.2) < 0.07 && v >= 1.28 && v <= 1.5;
            const basket = Math.abs(u) < 0.28 && v > 1.5 && v < 2.05;
            if (neck || rope || basket) {
              const b = (basket ? 0.62 : neck ? 0.5 : 0.38) * alpha;
              plotOver(x, y, b, 0.09, 0.52);
            }
          }
        }
      };

      /** 星星只在初始化时撒一次，横向位置交给漂移，之后不动的只有它们的呼吸。 */
      const buildStars = () => {
        const count = Math.round(Math.min(340, cols * 1.35));
        stars = [];
        for (let i = 0; i < count; i += 1) {
          // 大多数星星都很暗很远，亮的只有少数几颗 —— 密度一平均就变成噪点
          const z = Math.pow(Math.random(), 1.5);
          const warm = Math.random() < 0.22;
          stars.push({
            x: Math.random() * cols,
            y: Math.random() * Math.max(2, bandTop * 0.98),
            z,
            hue: warm ? 0.09 + Math.random() * 0.05 : 0.52 + Math.random() * 0.1,
            sat: warm ? 0.45 : 0.08 + Math.random() * 0.34,
            phase: Math.random() * TAU,
            tw: 0.3 + Math.random() * 0.8,
          });
        }
      };

      /** 流星带里的流星：轨道、速度、相位在初始化时一次定死 */
      const buildMeteors = () => {
        const count = Math.round(clamp(cols * 0.11, 8, 22));
        meteors = [];
        for (let i = 0; i < count; i += 1) {
          const warm = Math.random() < 0.24;
          meteors.push({
            x: Math.random() * cols,
            par: 0.55 + Math.random() * 0.45, // 跟着天空漂移的系数
            speed: 0.34 + Math.random() * 0.5, // 每秒走完轨道全长的几分之一
            phase: Math.random(), // 各自的相位：免得一起掉下来
            len: 4 + Math.floor(Math.random() * 7), // 尾巴长度（行）
            slant: 2 + Math.random() * 8, // 整段下落里向左偏多少列
            gain: 0.76 + Math.random() * 0.34,
            hue: warm ? 0.08 + Math.random() * 0.05 : 0.5 + Math.random() * 0.1,
            sat: warm ? 0.5 : 0.14 + Math.random() * 0.3,
          });
        }
      };

      /** 热气球：白天才放出来，数量很少 —— 天上飘十几个气球就成了游乐园 */
      const buildBalloons = () => {
        balloons = [];
        const count = Math.round(clamp(cols * 0.014, 2, 4));
        for (let i = 0; i < count; i += 1) {
          const warm = Math.random() < 0.72;
          balloons.push({
            x: Math.random() * cols,
            y: bandTop * (0.2 + Math.random() * 0.42),
            r: Math.max(2.6, cols * 0.019) * (0.82 + Math.random() * 0.42),
            // 每秒走多少列：横穿一屏要几分钟 —— 气球本来就是慢慢飘的
            speed: (0.7 + Math.random() * 0.6) * cols * 0.004,
            hue: warm ? 0.015 + Math.random() * 0.055 : 0.54 + Math.random() * 0.07,
            hue2: warm ? 0.11 + Math.random() * 0.04 : 0.09,
            bob: Math.random() * TAU,
          });
        }
      };

      /** 鸟群：几群，每群排成一个松散的 V —— 一只领头，两侧依次拉开 */
      const buildFlocks = () => {
        flocks = [];
        const count = Math.round(clamp(cols * 0.011, 1, 3));
        for (let i = 0; i < count; i += 1) {
          const n = 5 + Math.floor(Math.random() * 5);
          const birds: Bird[] = [];
          for (let k = 0; k < n; k += 1) {
            const side = k % 2 === 0 ? -1 : 1;
            const rank = Math.floor(k / 2) + 1;
            birds.push({
              // 间距要够开：一只鸟本身就占三格，挤在一起会糊成一团黑
              dx: side * rank * (1.7 + Math.random() * 0.9),
              dy: rank * (0.8 + Math.random() * 0.5) + (Math.random() - 0.5) * 0.6,
              phase: Math.random() * TAU,
              flap: 3.4 + Math.random() * 2.4, // 扇翅快慢，每只略不同才不像复制品
            });
          }
          flocks.push({
            x: Math.random() * cols,
            y: bandTop * (0.1 + Math.random() * 0.52),
            // 比气球快得多：鸟要看出「在飞」，气球只要看出「在飘」
            speed: (0.9 + Math.random() * 0.7) * cols * 0.017,
            bob: Math.random() * TAU,
            birds,
          });
        }
      };

      /** 量出一格字符的真实尺寸，再把视口切成网格 */
      const build = () => {
        if (!canvas || !ctx) return;

        W = Math.max(320, Math.round(window.innerWidth));
        H = Math.max(400, Math.round(window.innerHeight));
        const dpr = clamp(window.devicePixelRatio || 1, 1, 1.75);

        // 字符密度：一列约 7.2px，比上一版密了将近三倍。
        // 上限 220 列是给超宽屏兜底的 —— 实测这个密度每帧只要几毫秒，
        // 真掉帧了还有 considerDegrade() 在下面接着。
        const targetCols = Math.round(clamp((W / 7.2) * quality, 54, 220));

        // 用「十个 M 的宽度」反推字号，保证列宽正好是一个等宽字符的宽度。
        let fontSize = Math.max(9, W / (targetCols * 0.6));
        for (let i = 0; i < 3; i += 1) {
          ctx.font = `${fontSize}px ${FONT}`;
          const adv = ctx.measureText('MMMMMMMMMM').width / 10;
          if (!adv || !Number.isFinite(adv)) break;
          fontSize = Math.max(9, fontSize * (W / targetCols / adv));
        }
        fontSize = Math.max(9, Math.round(fontSize * 2) / 2);

        ctx.font = `${fontSize}px ${FONT}`;
        const adv = ctx.measureText('MMMMMMMMMM').width / 10;
        cellW = adv > 0.5 ? adv : fontSize * 0.6;
        cellH = Math.round(fontSize * 1.02);

        cols = Math.max(24, Math.ceil(W / cellW));
        rows = Math.max(20, Math.ceil(H / cellH));
        aspect = cellH / cellW;

        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        canvas.style.width = `${W}px`;
        canvas.style.height = `${H}px`;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.font = `${fontSize}px ${FONT}`;
        ctx.textAlign = 'left';
        ctx.textBaseline = 'top';

        intensity = new Float32Array(cols * rows);
        hueBuf = new Float32Array(cols * rows);
        satBuf = new Float32Array(cols * rows);

        // 三段分界：上面是宇宙，中间是流星带，下面是大海
        bandTop = Math.round(rows * SKY_EDGE);
        horizon = Math.round(rows * SEA_EDGE);
        /* 月亮的**大小**和视口有关，所以在这里定；**位置**和本地时间有关，
           每帧在 drawScene 里算 —— 两者分开，窗口一改大小位置也不会跳。 */
        moonR = Math.max(3.2, Math.min(cols * 0.032, bandTop * 0.24));

        buildStars();
        buildMeteors();
        buildBalloons();
        buildFlocks();
      };

      /** 把这一帧的「星海」写进 intensity / hue / sat 三个缓冲 */
      const drawScene = (t: number) => {
        intensity.fill(0);

        /* 整片天空向左漂了多少列。星云、星、月都从这里取位移：
           同一个 drift 配不同的系数，就是一层一层的视差。

           现在它由两部分合成：
             nightU * SKY_NIGHT_SPAN —— 天球跟着夜一起转，起点由本地时间决定
             t * SKY_DRIFT           —— 原来那点自转，保证画面始终是活的 */
        const nightU = nightPhase();
        const drift = nightU * cols * SKY_NIGHT_SPAN + t * SKY_DRIFT * cols;

        /* ---------- 月亮的位置：完全由本地时间决定 ----------
           u = 0 东边升起 → 0.5 天顶 → 1 西边落下，横坐标线性、纵坐标走一道弧。
           纵坐标夹在「贴顶」与「贴地平线」之间，所以升起和落下时它都压得很低。

           淡入淡出**只看横坐标，不看白天/黑夜**：横坐标是连续的，所以 06:00
           那一刻不会有「啪」地一跳；白天 moonXs 已经跑到画面外，fade 自然是 0。 */
        const moonArc = nightU < 1 ? Math.pow(Math.sin(Math.PI * nightU), MOON_ARC_POW) : 0;
        const moonXs = cols * lerp(MOON_RISE_X, MOON_SET_X, nightU);
        const moonTopY = moonR * aspect + 1;
        const moonLowY = Math.max(moonTopY, bandTop - moonR * aspect - 1);
        const moonY = lerp(moonLowY, moonTopY, moonArc);
        /* 窗口取窄一点：月亮升起来之后很快就该看得见了，淡得太久等于没升。
           同时两端必须淡到 0（升起点在画面外），否则 18:00 那一帧会突然冒出来。 */
        const moonWin = Math.max(moonR * 0.7, cols * 0.015);
        const moonFade =
          smoothstep(0, moonWin, moonXs) * smoothstep(0, moonWin, cols - moonXs);

        /* ---------- 太阳的位置：和月亮同一条轨道，只是走的是白天那半圈 ----------
           d = 0 日出 → 0.5 天顶 → 1 日落。两者在 06:00 / 18:00 都贴着地平线，
           所以「月亮刚落下、太阳刚升起」是同一套坐标算出来的，接得上。 */
        const isDay = nightU >= 1;
        const dayPhase = isDay ? nightU - 1 : 0;
        const dayness = isDay ? Math.pow(Math.sin(Math.PI * dayPhase), DAY_CURVE) : 0;
        const sunArc = isDay ? Math.pow(Math.sin(Math.PI * dayPhase), MOON_ARC_POW) : 0;
        const sunXs = cols * lerp(MOON_RISE_X, MOON_SET_X, dayPhase);
        const sunY = lerp(moonLowY, moonTopY, sunArc);
        const sunFade = isDay
          ? smoothstep(0, moonWin, sunXs) * smoothstep(0, moonWin, cols - sunXs)
          : 0;
        /* 水面上那条光路只有一个光源：白天跟太阳、夜里跟月亮。
           切换点上两者都是 0（月亮早跑出画面、太阳刚露头），所以不会跳。 */
        const lightXs = isDay ? sunXs : moonXs;
        const lightFade = isDay ? sunFade : moonFade;
        /* 星星、星云、流星按天光一起退场 */
        const nightGain = 1 - dayness;

        /* 底色渐变：透明度跟着 dayness 走，夜里是 0（等于没垫） */
        dayFillAlpha = DAY_TONE.fill * dayness;
        dayFillTop = DAY_TONE.fillTop;
        dayFillBot = DAY_TONE.fillBot;
        /* 海面顶上接住地平线的颜色（那一片在反射天光），往下压到 seaDeep */
        dayFillSeaTop = DAY_TONE.fillBot;
        dayFillSeaDeep = DAY_TONE.seaDeep;

        /* 标题那圈暗色晕罩：白天要淡到没有。
           天亮之后标题自己换成了深蓝，再压一层黑罩反而是把对比度拉低 ——
           深字配亮天本来就清楚，罩子该退场。只在变化超过 0.02 时才写 CSS 变量。 */
        const toneDark = smoothstep(0.1, 0.55, dayness) * DAY_TONE.titleDark;
        const haloAlpha = 0.93 * (1 - toneDark);
        const titleGlow = 0.38 * (1 - 0.9 * toneDark);
        if (Math.abs(haloAlpha - lastHalo) > 0.02) {
          lastHalo = haloAlpha;
          const root = document.documentElement.style;
          root.setProperty('--halo', haloAlpha.toFixed(3));
          root.setProperty('--title-glow', titleGlow.toFixed(3));
        }
        /* 标题配色跟着白天走；跨过一档才会真的重画（titleRedraw 内部会挡掉） */
        titleRedraw?.(toneDark);

        /* ---------- 0) 白天的天光：先把天铺亮，后面几层再叠上去 ----------
           夜里 dayness = 0，这一段整块跳过，代价为零。 */
        if (dayness > 0.004) {
          for (let y = 0; y < bandTop; y += 1) {
            const v = y / Math.max(1, bandTop); // 0 天顶 → 1 地平线
            const base = dayness * (DAY_TONE.zen + DAY_TONE.hor * Math.pow(v, 1.2));
            if (base <= 0.02) continue;
            /* 地平线那一带往暖白偏：真实白昼的地平线是被大气染过的暖色。
               色相怎么走由 warmBlend 管（不能直接插值，会从绿色穿过去）。 */
            const warmAmt = DAY_TONE.warm * smoothstep(0.3, 1, v);
            const [hueWarm, satWarm] = warmBlend(
              lerp(DAY_TONE.hueTop, DAY_TONE.hueBot, v),
              lerp(DAY_TONE.satTop, DAY_TONE.satBot, v),
              warmAmt,
            );
            for (let x = 0; x < cols; x += 1) {
              const idx = y * cols + x;
              /* 太阳周围把天光本身抬起来，而不是画一个硬边光晕 ——
                 1/(1+d²) 比 exp 便宜，形状几乎一样。 */
              const dsx = (x - sunXs) / Math.max(8, cols * 0.17);
              const dsy = (y - sunY) / Math.max(6, bandTop * 0.55);
              const halo = 1 / (1 + (dsx * dsx + dsy * dsy) * 1.7);
              const n = valueNoise(x * 0.03 + 3.1, y * 0.045 + 7.7);
              /* 再叠一层低频：白天要是只有一层细颗粒，天就成了一张均匀的网。
                 这一层频率低得多，起伏就是「云的块」。 */
              const n2 = valueNoise(x * 0.011 + 21.3, y * 0.018 + 9.4);
              /* 还要撒一点**逐格**的抖动。天光本身是平滑的，但字符是按亮度挑的 ——
                 平滑的梯度会让同一行每格都挑到同一种字，几十行叠起来就是一道道横纹
                 （看着像扫描线）。逐格抖一下把行打断，纹理才是散开的。 */
              const jitter = (hash2(x * 7 + 3, y * 11 + 5) - 0.5) * 0.22;
              const b = base * (0.7 + 0.28 * n + 0.36 * n2) + dayness * 0.3 * halo + jitter;
              if (b <= intensity[idx]) continue;
              intensity[idx] = b;
              // 太阳附近再往暖里偏一点
              hueBuf[idx] = hueWarm - halo * 0.07 + (n2 - 0.5) * 0.03;
              satBuf[idx] = satWarm - halo * 0.16;
            }
          }
        }

        /* ---------- 1) 星云：天空的底色，紫到品红，跟着天一起往左漂 ---------- */
        for (let y = 0; y < bandTop && nightGain > 0.004; y += 1) {
          // 阈值拉高：噪声只有最高的那一部分才结成云，天空大部分留黑 —— 太空本来就该是空的
          const nfade =
            smoothstep(0, bandTop * 0.1, y) * (1 - 0.7 * smoothstep(bandTop * 0.78, bandTop, y));
          if (nfade <= 0.002) continue;
          const ny = y * 0.042;
          for (let x = 0; x < cols; x += 1) {
            // 云是最远的一层，只走星星三分之一的位移
            const nx = (x + drift * 0.36) * 0.023;
            const a = smoothstep(0.6, 1, fbm(nx, ny));
            if (a <= 0.02) continue;
            const idx = y * cols + x;
            const cloud = a * nfade * 0.4 * nightGain;
            if (cloud <= intensity[idx]) continue;
            intensity[idx] = cloud;
            hueBuf[idx] = lerp(0.87, 0.73, smoothstep(0.35, 0.85, valueNoise(nx * 1.9 + 5.5, ny * 1.9)));
            satBuf[idx] = 0.56;
          }
        }

        /* ---------- 2) 流星带：天与海之间新长出来的一段 ----------
           这一段里没有实体，只有一层越往下越浓的雾 —— 大气最远的那一头。
           单格都暗到几乎看不见，几十行叠起来才成一条过渡带。 */
        for (let y = bandTop; y < horizon; y += 1) {
          const v = (y - bandTop) / Math.max(1, horizon - bandTop); // 0 = 带顶，1 = 地平线
          // 白天这一段跟着天光一起亮：它本来就是「大气的厚度」，天亮它就该亮
          const mist =
            (0.03 + 0.13 * Math.pow(v, 1.5)) * 0.9 +
            dayness * DAY_GAIN * 0.36 * Math.pow(v, 1.1);
          const ny = y * 0.05;
          /* 从上到下由紫转青：接住上面的星云，也接住下面的地平线。
             白天整段往天光那支蓝里靠，越贴近地平线越暖（warmBlend 管色相路径）。 */
          const warmAmt = DAY_TONE.warm * smoothstep(0.25, 1, v);
          const [dayHue, daySat] = warmBlend(0.565, 0.38, warmAmt);
          const mistHue = lerp(lerp(0.72, 0.545, v), dayHue, dayness * 0.8);
          const mistSat = lerp(0.52, daySat, dayness);
          for (let x = 0; x < cols; x += 1) {
            const nx = (x + drift * 0.3) * 0.021;
            const n =
              valueNoise(nx, ny + 3.3) * 0.62 + valueNoise(nx * 2.1 + 9.7, ny * 2.2) * 0.38;
            const b = mist * (0.35 + 1.05 * n);
            if (b <= 0.012) continue;
            plot(x, y, b, mistHue, mistSat);
          }
        }

        /* ---------- 3) 流星：一个个字符从带顶落向地平线 ----------
           每颗流星有自己的轨道和周期，亮度走一条 sin 曲线 —— 进场时慢慢亮起来，
           中段最亮，然后一路暗下去熄灭，尾巴在后面一级一级变淡。
           位置全是时间的函数，没有任何逐帧随机数（那会变成闪烁，就又成噪音了）。 */
        const bandH = horizon - bandTop + 1;
        for (let i = 0; i < meteors.length && nightGain > 0.004; i += 1) {
          const m = meteors[i];
          const p = (t * m.speed + m.phase) % 1;
          const headY = bandTop - m.len + p * (bandH + m.len);
          // 亮度只跟「掉到带里的哪个位置」有关，跟尾巴多长无关：
          // prog=0 刚进带顶（暗）→ 0.5 中段（最亮）→ 1 到地平线（又暗下去）。
          const prog = (headY - bandTop) / bandH;
          if (prog <= 0 || prog >= 1) continue;
          const env = Math.pow(Math.sin(prog * Math.PI), 1.25);
          const mx = wrap(m.x - drift * m.par - p * m.slant, cols);
          for (let k = 0; k < m.len; k += 1) {
            const y = Math.round(headY - k);
            if (y < bandTop || y >= horizon) continue;
            const b = env * Math.pow(1 - k / m.len, 2.2) * m.gain * nightGain;
            if (b <= 0.05) continue;
            // 尾巴往右上拖，因为它是在往左下掉
            plot(Math.round(mx + k * 0.24), y, b, m.hue, m.sat);
          }
        }

        /* ---------- 4) 星星：越近越亮的点，加一点点很慢的呼吸 ---------- */
        for (let i = 0; i < stars.length && nightGain > 0.004; i += 1) {
          const s = stars[i];
          // 位移按 z 分档：近的（z 大）跑得快，远的几乎黏在星云上 —— 第二层视差
          const sx = wrap(s.x - drift * (0.5 + 1.05 * s.z), cols);
          // 走到两端就淡进淡出，否则绕回来那一瞬间会「啪」地冒出一颗
          const edge = smoothstep(0, 5, sx) * smoothstep(0, 5, cols - sx);
          if (edge <= 0.02) continue;
          const twinkle = 0.72 + 0.28 * Math.sin(t * s.tw + s.phase);
          const fade = 1 - 0.82 * smoothstep(bandTop * 0.72, bandTop, s.y);
          const b = (0.06 + 0.92 * s.z) * twinkle * fade * edge * nightGain;
          if (b <= 0.05) continue;
          const xi = Math.round(sx);
          const yi = Math.round(s.y);
          plot(xi, yi, b, s.hue, s.sat);
          if (s.z > 0.68) {
            const halo = b * 0.3;
            plot(xi + 1, yi, halo, s.hue, s.sat);
            plot(xi - 1, yi, halo, s.hue, s.sat);
            plot(xi, yi + 1, halo * 0.9, s.hue, s.sat);
            plot(xi, yi - 1, halo * 0.9, s.hue, s.sat);
          }
          if (s.z > 0.9) {
            const flare = b * 0.2;
            plot(xi + 2, yi, flare, s.hue, s.sat);
            plot(xi - 2, yi, flare, s.hue, s.sat);
            plot(xi, yi + 2, flare, s.hue, s.sat);
            plot(xi, yi - 2, flare, s.hue, s.sat);
          }
        }

        /* ---------- 5) 月亮：画面唯一的实体，也是海面那条光路的源头 ----------
           位置（moonXs / moonY / moonFade）已经在上面按本地时间算好了，这里只负责画。 */
        const y0 = Math.max(0, Math.floor(moonY - moonR * aspect - 2));
        const y1 = Math.min(rows - 1, Math.ceil(moonY + moonR * aspect + 2));
        const x0 = Math.max(0, Math.floor(moonXs - moonR - 2));
        const x1 = Math.min(cols - 1, Math.ceil(moonXs + moonR + 2));
        for (let y = y0; y <= y1; y += 1) {
          for (let x = x0; x <= x1; x += 1) {
            const d = Math.hypot(x - moonXs, (y - moonY) * aspect) / moonR;
            if (d <= 1) {
              // 中心亮、边缘收一点 = 球的体积感；叠一层低频噪声做出月海的斑驳。
              // 亮度刻意压在 1 以下，让圆盘里有 # % @ 的层次，而不是糊成一块白。
              const sphere = 0.86 + 0.26 * (1 - d * d);
              const mare = 0.84 + 0.3 * valueNoise(x * 0.42 + 11.7, y * 0.42 + 4.3);
              const rim = smoothstep(1, 0.86, d);
              plot(x, y, 1.04 * sphere * mare * rim * moonFade, 0.12, 0.26);
            } else if (d < 1.5) {
              const g = Math.pow(1 - (d - 1) / 0.5, 2.2) * 0.2 * moonFade;
              if (g > 0.02) plot(x, y, g, 0.125, 0.4);
            }
          }
        }

        /* ---------- 5b) 太阳：白天的光源，和月亮同一条轨道、同一个大小 ----------
           颜色要的是**高饱和 + 高亮度**，不是低饱和。
           调色板的亮度上限只有 80%，低饱和的暖色落在这里就是一块土褐色的盘子；
           hsl(45, 100%, 69%) 才是那种金黄 —— 靠饱和度把它顶上去。 */
        if (sunFade > 0.01) {
          const sy0 = Math.max(0, Math.floor(sunY - moonR * aspect - 2));
          const sy1 = Math.min(rows - 1, Math.ceil(sunY + moonR * aspect + 2));
          const sx0 = Math.max(0, Math.floor(sunXs - moonR - 2));
          const sx1 = Math.min(cols - 1, Math.ceil(sunXs + moonR + 2));
          for (let y = sy0; y <= sy1; y += 1) {
            for (let x = sx0; x <= sx1; x += 1) {
              const d = Math.hypot(x - sunXs, (y - sunY) * aspect) / moonR;
              if (d <= 1) {
                /* 中心偏白、边缘偏金：亮度被调色板压在 80% 以下，
                   「白热」只能靠**降饱和**做 —— 中心 0.56、边缘 0.98。 */
                const core = 1 - d * d;
                plot(x, y, 1.08 * (0.86 + 0.24 * core) * sunFade, 0.125, 0.98 - 0.42 * core);
              } else if (d < 1.95) {
                const g = Math.pow(1 - (d - 1) / 0.95, 2.2) * 0.5 * sunFade;
                if (g > 0.02) plot(x, y, g, 0.1, 0.46);
              }
            }
          }
        }

        /* ---------- 6) 地平线：流星带与海的分界，也是纵深的最远处 ---------- */
        for (let y = Math.max(0, horizon - 5); y <= Math.min(rows - 1, horizon + 4); y += 1) {
          const g = Math.exp(-Math.pow((y - horizon - 0.2) / 0.95, 2));
          if (g < 0.01) continue;
          const above = clamp((horizon - y) / 5, 0, 1);
          /* 白天这条光带跟着天光一起抬起来，并往暖白偏 —— 夜里那条是冷青的。
             暖白同样要先把饱和度压掉，不然色相从青走到暖会经过绿色。 */
          const glow = g * lerp(0.66, 0.36, above) + g * dayness * DAY_GAIN * 0.2;
          const nightH = lerp(0.505, 0.77, above * 0.85);
          const [dayH, dayS] = warmBlend(0.565, 0.34, DAY_TONE.warm);
          const h = lerp(nightH, dayH, dayness * 0.8);
          const s = lerp(lerp(0.42, 0.56, above), dayS, dayness);
          for (let x = 0; x < cols; x += 1) {
            // 沿线明暗不均，才像一条被水汽切碎的光，而不是拿尺子画的一根亮线
            const mod =
              valueNoise(x * 0.14 + 3.1, y * 0.9) * 0.65 + valueNoise(x * 0.05 + 31.7, y * 0.4) * 0.35;
            plot(x, y, glow * (0.35 + 0.85 * mod), h, s);
          }
        }

        /* ---------- 7) 海面：透视压缩的浪 + 月光碎成的一条路 ---------- */
        const seaRows = rows - horizon;
        /* 浪线沿「距离」方向排布，而不是沿屏幕方向。
           近处的浪一波要占十几行，远处的浪一行就好几波 —— 这种疏密差就是纵深感本身。
           频率随 v 线性收窄（而不是用 1/v），远处的波纹才不会密到糊成一片噪点。
           相位只跟 y 走，x 上只留一点很轻的扰动，浪线才是连贯的横线而不是一堆散点。 */
        let wavePhi = 0;
        for (let y = horizon; y < rows; y += 1) {
          const v = (y - horizon + 1) / seaRows; // 0 = 最远（地平线），1 = 最近（画面底部）
          const near = Math.pow(v, 1.6);
          wavePhi += 0.42 + 1.55 * Math.pow(1 - v, 1.6); // 每行推进的相位：远处快、近处慢

          const drift = t * (0.5 + 1.05 * near);
          const vseed = valueNoise(y * 0.41, 7.7) * TAU;
          const haze = Math.exp(-v * 4.2); // 远处被地平线的光雾化
          // 浪与浪之间的水面压得很暗：对比度越高，越像一片有深度的水
          const band =
            (0.02 + 0.26 * haze) * (0.75 + 0.25 * Math.sin(v * 9 - t * 0.45)) * (1 - 0.5 * near) +
            dayness * DAY_TONE.sea * (0.13 + 0.24 * haze); // 白天整片水面抬亮：亮天配黑海，反差会假
          const rowHue = lerp(0.5 + 0.105 * near, 0.552, dayness * 0.65); // 近处的蓝更深
          const rowSat = lerp(
            0.34 + 0.3 * near,
            lerp(0.3, 0.22, DAY_TONE.seaWarm),
            dayness * 0.6,
          ); // 近处更饱和，远处更灰；白天再退一点饱和，才像被阳光晒过的水
          const spread = 4 + 28 * near; // 那条光路越近越宽
          // 浪尖：近处又亮又宽；远处淡到只剩雾，免得高频波纹在远处糊成噪点
          const crestGain = (0.25 + 0.78 * near) * smoothstep(0, 0.28, v);

          for (let x = 0; x < cols; x += 1) {
            // 浪线自身的起伏（幅度压在 0.9 弧度以内，保证每一行都还能见到浪尖）
            const swell =
              0.55 * Math.sin(x * 0.075 + t * 0.42 + vseed) +
              0.35 * Math.sin(x * 0.031 - t * 0.26 + vseed * 1.7);
            // 相位 = 横向的轻微倾斜 + 沿距离推进的波 + 起伏
            const ang = x * 0.055 + wavePhi - drift + swell;
            // 起浪的门槛沿横向缓慢变化：浪线因此断断续续、成组出现，而不是一根根等宽横条
            const thr = 0.52 + 0.24 * Math.sin(x * 0.045 + t * 0.3 + vseed * 1.3);
            const crest = Math.pow(smoothstep(thr, 0.99, Math.sin(ang)), 1.3);
            // 细碎的波纹，只负责给浪尖加一点颗粒
            const chop = 0.5 + 0.5 * Math.sin(x * 0.55 + wavePhi * 2.4 - t * 1.6 + vseed);
            // 一片浪的大小有别：成组的浪头才不像拉出来的条纹
            const group = 0.5 + 0.5 * valueNoise(x * 0.045 + 17.3, vseed * 2.1);

            /* 那条光路钉在**光源**的横坐标上：夜里是月亮、白天是太阳。
               光源往左挪一格，水上碎光就跟一格；光源淡出时这条路一起淡掉，
               所以月亮「落下去」时海面是真的暗下来，太阳沉下去也一样。 */
            const dx = (x - lightXs) / spread;
            const shimmer = 0.5 + 0.5 * Math.sin(t * 1.7 + y * 0.55 + x * 0.11);
            const glitter =
              crest *
              Math.exp(-dx * dx * 3.6) *
              (0.18 + 0.72 * near) *
              shimmer *
              lightFade *
              (1 + dayness * 0.55); // 日头比月亮烈，碎光也更碎更亮

            // 远处的光雾也要有横向的疏密，否则地平线下面会是一条平滑的色带
            const farPatch = 0.55 + 0.9 * valueNoise(x * 0.06 + 5.1, v * 26 + 11.3);
            const value =
              band * farPatch + crest * crestGain * (0.3 + 0.4 * chop + 0.5 * group) + glitter;
            if (value <= 0.012) continue;

            let h = rowHue;
            let s = rowSat;
            if (glitter > 0.03) {
              const g = clamp(glitter * 2.6, 0, 1);
              h = lerp(rowHue, 0.125, g); // 碎在浪尖上的光（月/日）都是暖的
              s = lerp(rowSat, lerp(0.36, 0.22, dayness), g);
            }
            if (crest > 0.72) {
              s = lerp(s, 0.18, ((crest - 0.72) / 0.28) * 0.8); // 浪沫偏白
            }

            const idx = y * cols + x;
            if (value <= intensity[idx]) continue;
            intensity[idx] = value;
            hueBuf[idx] = h;
            satBuf[idx] = s;
          }
        }

        /* ---------- 8) 热气球与鸟群：白天才出来的活物 ----------
           放在最后画，因为它们走的是**强制覆盖**通道（见 plotOver）：
           鸟是逆光的剪影，比亮天更暗，用取最大值的 plot 会被天整个吃掉。
           两者都只在白天出现 —— 夜里 life 归零，整段跳过，代价为零。 */
        const life = smoothstep(0.1, 0.42, dayness);
        if (life > 0.01) {
          for (let i = 0; i < balloons.length; i += 1) {
            const bl = balloons[i];
            const pad = bl.r * 4; // 两端留出余量，好让它整个飘出去再绕回来
            const bx = wrap(bl.x - t * bl.speed + pad, cols + pad * 2) - pad;
            const by = bl.y + Math.sin(t * 0.24 + bl.bob) * 1.6;
            drawBalloon(bx, by, bl.r, bl.hue, bl.hue2, life);
          }
          for (let i = 0; i < flocks.length; i += 1) {
            const f = flocks[i];
            const fx = wrap(f.x - t * f.speed + 20, cols + 40) - 20;
            const fy = f.y + Math.sin(t * 0.33 + f.bob) * 1.4;
            for (let k = 0; k < f.birds.length; k += 1) {
              const bd = f.birds[k];
              const wing = Math.sin(t * bd.flap + bd.phase);
              const bx = Math.round(fx + bd.dx);
              const by = Math.round(fy + bd.dy + Math.sin(t * 1.1 + bd.phase) * 0.7);
              const lift = Math.round(wing * 1.2);
              /* 逆光剪影：亮度压到 0.4 上下（→ 疏的字形 + 低明度），饱和度也低。
                 第一版给到 0.6，结果只比天暗一点点，飞过去几乎看不见 ——
                 剪影要暗得干脆，哪怕字形稀一点。 */
              plotOver(bx - 1, by + lift, 0.38 * life, 0.58, 0.2);
              plotOver(bx + 1, by + lift, 0.38 * life, 0.58, 0.2);
              plotOver(bx, by, 0.48 * life, 0.58, 0.2);
            }
          }
        }
      };

      const hueIdx = (h: number) => {
        const v = h - Math.floor(h);
        const i = Math.floor(v * HUE_STEPS) % HUE_STEPS;
        return i < 0 ? i + HUE_STEPS : i;
      };

      const render = (t: number) => {
        if (!ctx) return;
        drawScene(t);

        ctx.clearRect(0, 0, W, H);

        /* 白天先在天空和海面底下垫一层渐变。
           一个等宽字符只覆盖格子三成左右，全画到最亮感知也只有 80/255 ——
           那是阴天不是白天。垫上这层之后字符退成底色上的纹理，天和海才是亮的。
           天空：天顶深、地平线亮；海面：贴着地平线最亮（反射天光），往下压深。 */
        if (dayFillAlpha > 0.004) {
          const skyPx = Math.max(1, horizon * cellH);
          const g = ctx.createLinearGradient(0, 0, 0, skyPx);
          g.addColorStop(0, dayFillTop);
          g.addColorStop(Math.min(0.95, bandTop / Math.max(1, horizon)), dayFillBot);
          g.addColorStop(1, dayFillBot);
          ctx.globalAlpha = dayFillAlpha;
          ctx.fillStyle = g;
          ctx.fillRect(0, 0, W, skyPx);

          /* 海面也垫一层：贴着地平线最亮（那一片在反射天光），往下压深 ——
             近处的水本来就比远处暗。不垫的话，亮天配黑海会很假。 */
          const seaTop = Math.max(0, Math.min(H - 1, Math.floor(horizon * cellH)));
          const g2 = ctx.createLinearGradient(0, seaTop, 0, H);
          g2.addColorStop(0, dayFillSeaTop);
          g2.addColorStop(0.16, dayFillSeaDeep);
          g2.addColorStop(1, dayFillSeaDeep);
          ctx.globalAlpha = dayFillAlpha * 0.72;
          ctx.fillStyle = g2;
          ctx.fillRect(0, seaTop, W, H - seaTop);
          ctx.globalAlpha = 1;
        }

        const ramp = RAMPS[mode];
        const lastChar = ramp.length - 1;
        const binary = mode === 'binary';

        for (let y = 0; y < rows; y += 1) {
          const py = y * cellH;
          const rowBase = y * cols;
          for (let x = 0; x < cols; x += 1) {
            const idx = rowBase + x;
            let b = intensity[idx];
            // 负数 = 强制覆盖（热气球 / 鸟剪影），取绝对值，后面的逻辑一律不用改
            if (b < 0) b = -b;

            let ch: string;
            let lit: number;
            let hh: number;
            let ss: number;

            if (binary) {
              if (b <= 0) {
                // 空无一物的地方也铺一层很暗的 0：这就是「01 字符串」的那层底
                ch = '0';
                // 海面以下压得更暗：01 模式下也要能读出纵深
                lit = y < horizon ? 0.15 : 0.085;
                hh = 0.6;
                ss = 0.42;
              } else {
                if (b > 1) b = 1;
                // 有序抖动：亮度高于阈值就写 1，否则写 0 —— 一片区域里 1 越密就越亮
                const one = b > BAYER[(y & 3) * 4 + (x & 3)];
                ch = one ? '1' : '0';
                lit = one ? 0.34 + 0.56 * b : 0.15 + 0.3 * b;
                hh = hueBuf[idx];
                ss = satBuf[idx];
              }
            } else {
              // ASCII 模式下暗到看不见的格子干脆留空 —— 太空本来就该是黑的
              if (b <= 0.045) continue;
              if (b > 1) b = 1;
              const ci = clamp(Math.round(Math.pow(b, 0.82) * lastChar), 0, lastChar);
              ch = ramp[ci];
              if (ch === ' ') continue;
              lit = 0.1 + 0.74 * Math.pow(b, 0.8);
              hh = hueBuf[idx];
              ss = satBuf[idx];
            }

            const si = clamp(Math.round(ss * (SAT_STEPS - 1)), 0, SAT_STEPS - 1);
            const li = clamp(Math.round(lit * (LIT_STEPS - 1)), 0, LIT_STEPS - 1);
            ctx.fillStyle = palette[(hueIdx(hh) * SAT_STEPS + si) * LIT_STEPS + li];
            ctx.fillText(ch, Math.round(x * cellW), py);
          }
        }
      };

      /* ============================================================
         循环：锁 30fps，切后台就停；掉帧自动降密度。
         ============================================================ */
      const FRAME_MS = 1000 / 30;
      let raf = 0;
      let lastTime = 0;
      let acc = 0;

      const considerDegrade = () => {
        if (costAvg <= 20 || quality <= 0.5) return;
        quality = Math.max(0.5, quality - 0.18);
        costAvg = 8;
        build();
      };

      const frame = (now: number) => {
        raf = requestAnimationFrame(frame);
        if (!lastTime) lastTime = now;
        const dt = now - lastTime;
        lastTime = now;
        acc += dt;
        if (acc < FRAME_MS) return;
        acc = Math.min(acc % FRAME_MS, FRAME_MS);

        const t0 = performance.now();
        render(now / 1000);
        const cost = performance.now() - t0;
        costAvg = costAvg * 0.9 + cost * 0.1;

        frameCount += 1;
        if (frameCount % 90 === 0) considerDegrade();
      };

      const start = () => {
        if (reduced || raf) return;
        lastTime = 0;
        raf = requestAnimationFrame(frame);
      };

      const stop = () => {
        if (!raf) return;
        cancelAnimationFrame(raf);
        raf = 0;
      };

      /* ============================================================
         字集开关
         ============================================================ */
      const modeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.seg__btn'));
      const modeLabel = document.getElementById('mode-label');

      const setMode = (next: Mode) => {
        mode = next;
        for (const btn of modeButtons) {
          btn.setAttribute('aria-pressed', String(btn.dataset.mode === next));
        }
        if (modeLabel) modeLabel.textContent = next === 'binary' ? '01' : 'ASCII';
        try {
          localStorage.setItem('wired-charset', next);
        } catch {
          /* 隐私模式下存不了也无所谓 */
        }
        if (reduced) render(8);
      };

      for (const btn of modeButtons) {
        btn.addEventListener('click', () => {
          setMode(btn.dataset.mode === 'binary' ? 'binary' : 'ascii');
        });
      }

      try {
        // 也可以用 ?charset=01 直接指定，方便分享时带上自己喜欢的字集（优先于本地记忆）
        const wanted = new URLSearchParams(window.location.search).get('charset');
        const saved = localStorage.getItem('wired-charset');
        if (wanted === 'binary' || wanted === '01') setMode('binary');
        else if (wanted === 'ascii') setMode('ascii');
        else if (saved === 'binary' || saved === 'ascii') setMode(saved);
      } catch {
        /* 忽略 */
      }

      /* ============================================================
         时钟与访客计数（与主站同一个接口、同一个会话标记）
         ============================================================ */
      const clock = document.getElementById('clock');
      const tickClock = () => {
        if (clock) clock.textContent = new Date().toLocaleTimeString('zh-CN', { hour12: false });
      };
      tickClock();
      setInterval(tickClock, 1000);

      const digits = document.getElementById('visit-digits');
      if (digits) {
        const key = 'visit-counted';
        const shouldCount = !sessionStorage.getItem(key);

        fetch(shouldCount ? '/api/visit?inc=1' : '/api/visit', {
          headers: { accept: 'application/json' },
        })
          .then((response) =>
            response.ok ? response.json() : Promise.reject(new Error(String(response.status))),
          )
          .then((data: { count?: number }) => {
            if (typeof data.count !== 'number') return;
            sessionStorage.setItem(key, '1');
            digits.textContent = '';
            digits.dataset.state = 'ok';
            for (const digit of String(data.count).padStart(8, '0').slice(-8)) {
              const cell = document.createElement('i');
              cell.textContent = digit;
              digits.append(cell);
            }
          })
          .catch(() => {
            // 本地静态预览（没起 Functions）时静默降级，不打扰读者
            digits.dataset.state = 'error';
          });
      }

      /* ============================================================
         潮声：一段现场合成的噪声，低通后由极慢的 LFO 推动音量。
         默认关闭 —— 出声这件事必须由读者自己决定。
         ============================================================ */
      let audioCtx: AudioContext | undefined;
      let ambience: { src: AudioBufferSourceNode; lfo: OscillatorNode; gain: GainNode } | null = null;

      const ensureCtx = (): AudioContext | undefined => {
        const Ctor =
          window.AudioContext ??
          (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!Ctor) return undefined;
        audioCtx ??= new Ctor();
        return audioCtx;
      };

      /* ------------------------------------------------------------
         进入音：从入口门按 ENTER 过来的那一次，落页时补一声。
         声音没法跨文档 —— 在门口响、页面立刻被换掉，只会剩下半声，
         所以门那边只在按下的瞬间写一个一次性标记（wired-enter-sound），
         真正的播放挪到这里。这次跳转本身就是用户手势，浏览器会放行；
         万一被自动播放策略拦下（比如直接把网址贴进地址栏后又刷新），
         也只是没这一声，绝不挡页面。
         ------------------------------------------------------------ */
      const playEnterChime = (ctx: AudioContext) => {
        const now = ctx.currentTime + 0.02;
        [523.25, 659.25, 987.77].forEach((freq, index) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          const start = now + index * 0.06;
          osc.type = 'square';
          osc.frequency.value = freq;
          gain.gain.setValueAtTime(0.0001, start);
          gain.gain.exponentialRampToValueAtTime(0.05, start + 0.01);
          gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.18);
          osc.connect(gain).connect(ctx.destination);
          osc.start(start);
          osc.stop(start + 0.2);
        });
      };

      const consumeEnterSound = () => {
        let armed = false;
        try {
          armed = sessionStorage.getItem('wired-enter-sound') === '1';
          if (armed) sessionStorage.removeItem('wired-enter-sound');
        } catch {
          /* 隐私模式：读不到就没有这一声 */
        }
        if (!armed) return;

        const ctx = ensureCtx();
        if (!ctx) return;
        if (ctx.state === 'running') {
          playEnterChime(ctx);
          return;
        }
        // resume() 被自动播放策略挡住时返回的是一个永远不落地的 promise，
        // 所以这里只挂 then，不 await、不排队，挡不住任何东西。
        void ctx.resume().then(() => {
          if (ctx.state === 'running') playEnterChime(ctx);
        });
      };

      const soundBtn = document.getElementById('toggle-sound');

      const syncSound = (on: boolean) => {
        if (soundBtn) {
          soundBtn.textContent = `潮声：${on ? '开' : '关'}`;
          soundBtn.setAttribute('aria-pressed', String(on));
        }
      };

      const startAmbience = () => {
        if (ambience) return;
        const ctx = ensureCtx();
        if (!ctx) return;
        void ctx.resume();

        const seconds = 6;
        const length = Math.floor(ctx.sampleRate * seconds);
        const buffer = ctx.createBuffer(1, length, ctx.sampleRate);
        const data = buffer.getChannelData(0);
        let low = 0;
        let mid = 0;
        for (let i = 0; i < length; i += 1) {
          const white = Math.random() * 2 - 1;
          low = 0.995 * low + 0.005 * white; // 低频涌浪
          mid = 0.92 * mid + 0.08 * white; // 浪花的细碎
          data[i] = low * 3.2 + mid * 0.22;
        }

        const src = ctx.createBufferSource();
        src.buffer = buffer;
        src.loop = true;

        const hp = ctx.createBiquadFilter();
        hp.type = 'highpass';
        hp.frequency.value = 55;

        const lp = ctx.createBiquadFilter();
        lp.type = 'lowpass';
        lp.frequency.value = 700;
        lp.Q.value = 0.4;

        const gain = ctx.createGain();
        gain.gain.value = 0.0001;

        // 0.07 Hz 的 LFO 推着音量起伏 —— 一次「潮」大约 14 秒
        const lfo = ctx.createOscillator();
        lfo.type = 'sine';
        lfo.frequency.value = 0.07;
        const lfoDepth = ctx.createGain();
        lfoDepth.gain.value = 0.026;
        lfo.connect(lfoDepth).connect(gain.gain);

        src.connect(hp).connect(lp).connect(gain).connect(ctx.destination);
        src.start();
        lfo.start();
        gain.gain.linearRampToValueAtTime(0.05, ctx.currentTime + 2.5);

        ambience = { src, lfo, gain };
      };

      const stopAmbience = () => {
        if (!ambience || !audioCtx) return;
        const { src, lfo, gain } = ambience;
        const ctx = audioCtx;
        const now = ctx.currentTime;
        gain.gain.cancelScheduledValues(now);
        gain.gain.setValueAtTime(gain.gain.value, now);
        gain.gain.linearRampToValueAtTime(0.0001, now + 0.6);
        try {
          src.stop(now + 0.7);
          lfo.stop(now + 0.7);
        } catch {
          /* 已经停了，忽略 */
        }
        ambience = null;
      };

      soundBtn?.addEventListener('click', () => {
        const on = soundBtn.getAttribute('aria-pressed') !== 'true';
        if (on) startAmbience();
        else stopAmbience();
        syncSound(on);
      });

      /* ============================================================
         启动
         ============================================================ */
      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          build();
          if (reduced) render(8);
        }, 220);
      });

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stop();
        else start();
      });

      consumeEnterSound();

      if (canvas && ctx) {
        build();
        if (reduced) render(8);
        else start();
      }
    </script>
  </body>
</html>
