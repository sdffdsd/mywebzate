# ===== 复制为 .env，不要提交到仓库 =====

# --- Cloudflare Pages（GitHub Actions 部署用）---
# 令牌权限：Account > Cloudflare Pages > Edit；Account > Workers KV Storage > Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=personal-site

# --- 香港 / 境外 VPS 备用出口（可选，见 docs/技术路线.md）---
# 不备案但想让国内直连更稳时启用：国内线路解析到这台机器
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PATH=/var/www/personal-site

# --- 访客计数在 Node 端的落盘位置（香港 VPS 用）---
VISIT_DATA_FILE=.data/visits.json

# --- 留言板冷却 ---
# 给站主留言（私信）的冷却秒数，默认 300 = 5 分钟；设 0 关闭。
# 公开留言的冷却固定 20 秒，不受这个值影响。
GUESTBOOK_DM_COOLDOWN=300

# 其余留言板变量（GUESTBOOK_SALT / GUESTBOOK_ADMIN / GUESTBOOK_EMAIL /
# GUESTBOOK_EMAIL_FROM / RESEND_API_KEY / GUESTBOOK_PUSH）在 Pages 上
# 用 wrangler pages secret put 配置，见 docs/留言板-实现路径.md。
