---
/**
 * EntryGate —— 站点前置入口门（覆盖层）
 *
 * 门后是两条路：
 *   ▶ ENTER        → 进 /wired/（星海分站）。门就是分站的门。
 *   ▷ 静音进入主站 → 留在 za4ever.com 首页，只是把门收起来（不开音效）。
 *
 * 为什么是覆盖层而不是把首页搬到 /home/：
 *   1. 网址不变：za4ever.com 还是首页本身，canonical / 站内链接 / 外部反链全都不受影响。
 *   2. SEO 不变：正文照旧在 HTML 里，爬虫不执行 JS 就直接看到完整内容。
 *   3. 可随时撤回：去掉 BaseLayout 上的 gate 属性即可，其它文件不用动。
 *   4. 首屏更顺：主站资源在门后面照常并行加载，选「静音进入主站」时是瞬间展开，不是重新加载。
 *
 * ⚠️ 这个组件必须渲染在 <main> 之外（由 BaseLayout 负责摆放）。
 *    门显示时会给 header / main / footer 加 inert 来屏蔽背后内容，
 *    若门自己长在 main 里，它也会被 inert 掉 —— 按钮全部点不动。
 *
 * 四条工程底线继续遵守：
 *   - 零外部字体 / 图片 / 音频 / 第三方脚本（音效由 Web Audio 合成）。
 *   - 无 JS 时不显示门，读者不会被锁在门外（见 BaseLayout 里的 is-gated 标记）。
 *   - prefers-reduced-motion 下不做 glitch 抖动。
 *   - ENTER 是一个真正的链接（<a href="/wired/">），中键 / 新标签页打开照常可用；
 *     JS 只负责补一段进入音并顺手记下「本会话已进过站」。
 */
---

<div class="entry-gate" id="entry-gate" role="dialog" aria-modal="true" aria-label="站点入口">
  <div class="entry-gate__scan" aria-hidden="true"></div>
  <div class="entry-gate__vignette" aria-hidden="true"></div>

  <div class="entry-gate__inner">
    <p class="entry-gate__label">ZA4EVER.COM</p>
    <h1 class="entry-gate__title" data-text="WIRED NODE">WIRED NODE</h1>
    <p class="entry-gate__sub">这是一个人的站点 · 无框架 · 无追踪 · 永久施工中</p>

    <a class="entry-gate__btn" id="entry-gate-enter" href="/wired/">▶ ENTER</a>

    <p class="entry-gate__note">ENTER 进入星海分站 · 静音留在主站</p>
    <p class="entry-gate__hint">
      <button class="entry-gate__skip" id="entry-gate-skip" type="button">静音进入主站 →</button>
    </p>
  </div>
</div>

<style is:inline>
  /* 默认不显示：只有 BaseLayout 在 head 里判断「本次会话还没进过站」时才加 .is-gated。
     无 JS 时不会加，门自然不存在。 */
  .entry-gate {
    display: none;
  }

  html.is-gated {
    overflow: hidden;
  }

  html.is-gated .entry-gate {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-content: center;
    /* 不透明底色：避免主站内容在门出现之前闪一帧 */
    background-color: #06060a;
    background-image:
      repeating-linear-gradient(0deg, rgba(210, 115, 138, 0.055) 0 2px, transparent 2px 4px),
      repeating-linear-gradient(90deg, rgba(89, 207, 255, 0.035) 0 2px, transparent 2px 4px);
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "PingFang SC",
      "Microsoft YaHei", monospace;
    color: #c1b492;
    text-align: center;
    padding: 1.5rem;
    opacity: 1;
    transition: opacity 0.45s ease;
  }

  html.is-gated .entry-gate.is-gone {
    opacity: 0;
    pointer-events: none;
  }

  .entry-gate__scan,
  .entry-gate__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .entry-gate__scan {
    background: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.045) 0 1px,
      transparent 1px 3px
    );
    mix-blend-mode: overlay;
  }

  .entry-gate__vignette {
    background: radial-gradient(ellipse at center, transparent 48%, rgba(0, 0, 0, 0.9) 100%);
  }

  .entry-gate__inner {
    position: relative;
    display: grid;
    gap: 0.9rem;
    justify-items: center;
  }

  .entry-gate__label {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.32em;
    opacity: 0.6;
  }

  .entry-gate__title {
    position: relative;
    margin: 0;
    font-size: clamp(1.6rem, 7vw, 2.9rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #59cfff;
    text-shadow: 0 0 14px rgba(89, 207, 255, 0.65);
  }

  .entry-gate__title::before,
  .entry-gate__title::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
  }

  .entry-gate__title::before {
    color: #00ffff;
    animation: gate-glitch 2.4s steps(2) infinite;
  }

  .entry-gate__title::after {
    color: #ff3b6b;
    animation: gate-glitch 1.7s steps(2) infinite reverse;
  }

  @keyframes gate-glitch {
    0%, 91%, 100% { transform: translate(0, 0); clip-path: inset(0 0 0 0); }
    93% { transform: translate(-3px, 1px); clip-path: inset(14% 0 58% 0); }
    96% { transform: translate(3px, -2px); clip-path: inset(52% 0 22% 0); }
  }

  .entry-gate__sub {
    margin: 0;
    font-size: 0.84rem;
    opacity: 0.78;
  }

  .entry-gate__btn {
    display: inline-block;
    margin-top: 0.8rem;
    padding: 0.95rem 2.2rem;
    font: inherit;
    font-size: 0.95rem;
    letter-spacing: 0.24em;
    color: #59cfff;
    background: transparent;
    border: 2px solid #59cfff;
    cursor: pointer;
    text-decoration: none;
    text-shadow: 0 0 10px rgba(89, 207, 255, 0.65);
    box-shadow: 0 0 0 1px #000, 5px 5px 0 rgba(0, 0, 0, 0.65);
  }

  .entry-gate__btn:hover,
  .entry-gate__btn:focus-visible {
    background: rgba(89, 207, 255, 0.14);
  }

  .entry-gate__note,
  .entry-gate__hint {
    margin: 0;
    font-size: 0.76rem;
    opacity: 0.62;
  }

  .entry-gate__hint {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
  }

  /* 门里唯一的链接就是 ENTER 本身，配色交给 .entry-gate__btn，不再单独着色 */

  .entry-gate__skip {
    padding: 0;
    font: inherit;
    font-size: 0.76rem;
    color: inherit;
    background: none;
    border: 0;
    border-bottom: 1px dashed currentColor;
    cursor: pointer;
  }

  .entry-gate :focus-visible {
    outline: 2px solid #59cfff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .entry-gate__title::before,
    .entry-gate__title::after {
      animation: none;
    }
  }
</style>

<script>
  /** ENTER 指向的分站 */
  const WIRED_URL = '/wired/';

  const gate = document.getElementById('entry-gate');
  const enterLink = document.getElementById('entry-gate-enter');
  const skipBtn = document.getElementById('entry-gate-skip');
  const main = document.getElementById('main');

  /** 进入音：三声上行方波，全部由 Web Audio 合成，不需要音频文件。
      整体压在 0.3 秒内，这样「响完再跳转」不需要等太久。 */
  const playEnter = () => {
    const Ctor =
      window.AudioContext ??
      (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    if (!Ctor) return;

    const ctx = new Ctor();
    const now = ctx.currentTime;

    [523.25, 659.25, 987.77].forEach((freq, index) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      const start = now + index * 0.06;
      osc.type = 'square';
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0.0001, start);
      gain.gain.exponentialRampToValueAtTime(0.05, start + 0.01);
      gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.18);
      osc.connect(gain).connect(ctx.destination);
      osc.start(start);
      osc.stop(start + 0.2);
    });
  };

  /** 门后面的内容在 gated 期间对键盘与读屏都不可达 */
  const setBackgroundInert = (inert: boolean) => {
    for (const el of document.querySelectorAll<HTMLElement>('.site-header, main, .site-footer')) {
      // 兜底：万一门被放进了某个容器内部，绝不能把它的祖先设为 inert，
      // 否则门自己也会一起失效（表现为按钮点不动、也无法聚焦）。
      if (gate && el.contains(gate)) continue;
      el.inert = inert;
    }
  };

  /** 把门收起来，人留在本页（只记一笔「本会话已进过站」） */
  const dismissGate = () => {
    if (!gate || gate.classList.contains('is-gone')) return;
    gate.classList.add('is-gone');
    gate.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('is-gated');
    setBackgroundInert(false);

    // 淡出结束后彻底移除，别留下一个盖住整屏的图层
    setTimeout(() => gate.remove(), 500);

    // 焦点交给主内容，键盘用户下一步就能 Tab 进导航
    if (main) {
      main.tabIndex = -1;
      main.focus({ preventScroll: true });
    }
  };

  /** ENTER：先响一声，再把浏览器交给 /wired/ */
  const goWired = () => {
    if (!gate || gate.classList.contains('is-gone')) return;

    playEnter();
    gate.classList.add('is-gone');
    gate.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('is-gated');
    setBackgroundInert(false);

    // 留出 340ms 让进入音响起；无 JS 时这个链接就是普通链接，直接跳转
    setTimeout(() => window.location.assign(WIRED_URL), 340);
  };

  if (gate && document.documentElement.classList.contains('is-gated')) {
    try {
      sessionStorage.setItem('gate-passed', '1');
    } catch {
      /* 隐私模式下写不进去也无所谓，最多下次再拦一次 */
    }

    setBackgroundInert(true);

    // ENTER 本身是 <a href="/wired/">：新标签页 / 中键 / 无 JS 都能用。
    // 只有「不带修饰键的左键单击」才拦下来补一声进入音。
    enterLink?.addEventListener('click', (event) => {
      if (
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }
      event.preventDefault();
      goWired();
    });

    skipBtn?.addEventListener('click', dismissGate);

    document.addEventListener('keydown', (event) => {
      // Enter 交给聚焦中的 ENTER 链接自己处理（它就在默认焦点上），这里只管 Escape
      if (event.key === 'Escape') dismissGate();
    });

    enterLink?.focus({ preventScroll: true });
  }
</script>
