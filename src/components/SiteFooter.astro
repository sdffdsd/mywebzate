---
const year = new Date().getFullYear();

// 说明：这个站按“不备案 + 境外节点”部署，因此不需要展示 ICP 备案号。
// 如果你以后改用境内节点（EdgeOne Pages 中国大陆可用区 / 阿里云 CDN 等），
// 把 ICP 号填到下面即可，页脚会自动展示 —— 那是工信部的硬性要求。
const icp = '';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__col">
      <p class="muted">
        © {year} ZAKURA · 静态生成 · 部署于 Cloudflare Pages
      </p>
      <p class="muted">
        <a href="/wired/">→ 另一面：WIRED NODE</a>
      </p>
      {icp && (
        <p class="muted">
          <a href="https://beian.miit.gov.cn/" rel="nofollow noopener" target="_blank">{icp}</a>
        </p>
      )}
    </div>

    <div class="site-footer__col site-footer__col--right">
      <p class="muted">
        本站访客：<span id="visit-count" data-state="loading">—</span>
      </p>
      <p class="muted">音频为程序合成示例（CC0），可直接替换为你的作品。</p>
    </div>
  </div>
</footer>

<script>
  // 访客计数：调用 /api/visit（Cloudflare Pages Function 或 Node 备用出口，同一份逻辑）
  const el = document.getElementById('visit-count');

  if (el) {
    const key = 'visit-counted';

    // 同一浏览器会话只累加一次，避免刷新刷数字
    const shouldCount = !sessionStorage.getItem(key);

    fetch(shouldCount ? '/api/visit?inc=1' : '/api/visit', {
      headers: { accept: 'application/json' },
    })
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((data: { count?: number }) => {
        if (typeof data.count === 'number') {
          sessionStorage.setItem(key, '1');
          el.textContent = data.count.toLocaleString('zh-CN');
          el.dataset.state = 'ok';
        }
      })
      .catch(() => {
        // 静态预览（未启动函数）时静默降级，不打扰读者
        el.textContent = '—';
        el.dataset.state = 'error';
      });
  }
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 2.5rem 3.5rem;
    margin-top: 4rem;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .site-footer__col--right {
    text-align: right;
  }

  .site-footer p {
    margin: 0 0 0.35rem;
  }

  #visit-count[data-state='ok'] {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
</style>
