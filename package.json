{
  "name": "personal-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "gen:assets": "node scripts/gen-demo-assets.mjs",
    "serve:node": "node server/index.mjs",
    "deploy:cf": "astro build && wrangler pages deploy dist --project-name personal-site",
    "deploy:www-redirect": "cd workers/www-redirect && wrangler deploy",
    "kv:create": "wrangler kv namespace create VISITS"
  },
  "dependencies": {
    "astro": "^7.3.3",
    "gsap": "^3.15.0",
    "sharp": "^0.35.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "wrangler": "^4.136.2"
  },
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "workerd": true
  }
}
