---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import EntryGate from '../components/EntryGate.astro';

interface Props {
  title: string;
  description?: string;
  /** 是否在页面最前面加一道入口门（只有首页需要） */
  gate?: boolean;
}

const {
  title,
  description = '个人站点：图像、文字、动效与声音。',
  gate = false,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {
      gate && (
        <script is:inline>
          /*
            前置入口门：只有「本次会话还没进过站」时才给 <html> 打标记。
            必须放在 head 里同步执行，才能赶在首次绘制之前就位 ——
            否则主站内容会先闪一帧，再被门盖住。
            无 JS 时这段不会执行，门也不会出现，读者照常看得到完整内容。
          */
          try {
            if (!sessionStorage.getItem('gate-passed')) {
              document.documentElement.classList.add('is-gated');
            }
          } catch {
            document.documentElement.classList.add('is-gated');
          }
        </script>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#06070b" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>

    {/*
      门必须渲染在 <main> 之外。
      门显示时会给 header / main / footer 加 inert 来屏蔽背后的内容，
      如果门本身长在 main 里，它自己也会被 inert 掉 —— 按钮既不能点也不能聚焦。
      （这个坑真踩过一次：线上表现为 ENTER 与「静音进入」全部点不动。）
    */}
    {gate && <EntryGate />}

    <SiteFooter />

    <script>
      // 滚动进度条 + 通用进入动画：全站级别的轻交互，几 KB，无第三方依赖。
      const bar = document.getElementById('scroll-progress');
      let raf = 0;

      const updateBar = () => {
        raf = 0;
        if (!bar) return;
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const ratio = max > 0 ? doc.scrollTop / max : 0;
        bar.style.transform = `scaleX(${ratio.toFixed(4)})`;
      };

      addEventListener(
        'scroll',
        () => {
          if (!raf) raf = requestAnimationFrame(updateBar);
        },
        { passive: true },
      );
      updateBar();

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (reduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
